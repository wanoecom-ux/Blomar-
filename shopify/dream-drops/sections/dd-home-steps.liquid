{% comment %}
  How-it-works in two columns: heading, intro and numbered step cards on the left; a product image,
  button and caption on the right. Stacks on phones, image last.
{% endcomment %}
{%- assign s = section.settings -%}
{{ 'dd-product.css' | asset_url | stylesheet_tag }}
<style>
  #dd-hs-{{ section.id }} .dd-hs__grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); gap: 56px; align-items: center; }
  #dd-hs-{{ section.id }} .dd-h2 { font-size: 30px; color: var(--dd-ink) !important; margin: 4px 0 10px; }
  #dd-hs-{{ section.id }} .dd-lede { color: #4a5694; font-size: 14.5px; line-height: 1.65; margin: 0 0 18px; }
  #dd-hs-{{ section.id }} .dd-hs__steps { display: grid; gap: 12px; }
  #dd-hs-{{ section.id }} .dd-hs__step {
    display: flex; gap: 14px; align-items: flex-start; padding: 16px 18px; background: rgba(255, 255, 255, .92);
    border-radius: 14px; box-shadow: 0 4px 14px rgba(43, 58, 143, .07);
  }
  #dd-hs-{{ section.id }} .dd-hs__num {
    flex: none; width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center;
    background: var(--dd-pink); color: #fff; font-weight: 800 !important; font-size: 13px;
  }
  #dd-hs-{{ section.id }} .dd-hs__step h3 { margin: 2px 0 4px; font-size: 14.5px; color: var(--dd-ink) !important; letter-spacing: 0 !important; }
  #dd-hs-{{ section.id }} .dd-hs__step p { margin: 0; color: #4a5694; font-size: 13px; line-height: 1.6; }
  #dd-hs-{{ section.id }} .dd-hs__side { text-align: center; }
  #dd-hs-{{ section.id }} .dd-hs__side img { display: block; width: 100%; max-width: {{ s.image_width }}px; height: auto; margin: 0 auto; border-radius: 16px; box-shadow: 0 14px 32px rgba(43, 58, 143, .14); }
  #dd-hs-{{ section.id }} .dd-hs__btn { display: flex; align-items: center; justify-content: center; width: 100%; max-width: {{ s.image_width }}px; min-height: 48px; margin: 22px auto 0; text-decoration: none; font-size: 15px !important; }
  #dd-hs-{{ section.id }} .dd-hs__caption { margin: 12px auto 0; max-width: {{ s.image_width }}px; color: #5a6290; font-size: 12px; line-height: 1.6; }
  @media (max-width: 749px) {
    #dd-hs-{{ section.id }} .dd-hs__grid { grid-template-columns: 1fr; gap: 32px; }
    #dd-hs-{{ section.id }} .dd-h2 { font-size: 30px; }
    #dd-hs-{{ section.id }} .dd-lede { font-size: 16px; }
    #dd-hs-{{ section.id }} .dd-hs__step { padding: 22px 20px; gap: 16px; border-radius: 18px; }
    #dd-hs-{{ section.id }} .dd-hs__num { width: 34px; height: 34px; font-size: 15px; }
    #dd-hs-{{ section.id }} .dd-hs__step h3 { font-size: 16.5px; }
    #dd-hs-{{ section.id }} .dd-hs__step p { font-size: 15px; }
    #dd-hs-{{ section.id }} .dd-hs__btn { min-height: 60px; font-size: 18px !important; }
    #dd-hs-{{ section.id }} .dd-hs__caption { font-size: 14px; }
  }
</style>

<section class="dd dd-section dd-hs" id="dd-hs-{{ section.id }}" style="background: {{ s.background }};">
  <div class="dd-container" style="max-width: {{ s.width }}px;">
    <div class="dd-hs__grid">
      <div>
        {% render 'dd-heading', s: s %}
        <div class="dd-hs__steps">
          {%- for block in section.blocks -%}
            <div class="dd-hs__step" {{ block.shopify_attributes }}>
              <span class="dd-hs__num">{{ forloop.index }}</span>
              <div>
                <h3>{{ block.settings.title }}</h3>
                <p>{{ block.settings.text }}</p>
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
      <div class="dd-hs__side">
        {%- assign img = s.image | default: s.product.featured_media.preview_image -%}
        {%- assign url = s.button_link | default: s.product.url -%}
        {%- if img -%}<a href="{{ url }}" tabindex="-1">{{ img | image_url: width: 800 | image_tag: loading: 'lazy', alt: s.product.title, widths: '400, 600, 800' }}</a>{%- endif -%}
        {%- if s.button_label != blank -%}<a class="dd-btn dd-btn--accent dd-hs__btn" href="{{ url }}">{{ s.button_label }}</a>{%- endif -%}
        {%- if s.caption != blank -%}<p class="dd-hs__caption">{{ s.caption }}</p>{%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Dream Drops home steps",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow tag", "default": "How it works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Quick to give," },
    { "type": "text", "id": "highlight", "label": "Highlighted words", "default": "easy to keep up." },
    { "type": "text", "id": "heading_after", "label": "Words after highlight" },
    { "type": "richtext", "id": "text", "label": "Intro text" },
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Defaults to the product's first image." },
    { "type": "range", "id": "image_width", "label": "Image width", "min": 220, "max": 480, "step": 10, "unit": "px", "default": 340 },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Try it risk-free" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Leave empty to go to the product." },
    { "type": "text", "id": "caption", "label": "Caption under button" },
    { "type": "color_background", "id": "background", "label": "Background", "default": "linear-gradient(180deg, rgba(246, 233, 228, 1) 0%, rgba(232, 230, 246, 1) 100%)" },
    { "type": "range", "id": "width", "label": "Content width", "min": 700, "max": 1300, "step": 20, "unit": "px", "default": 960 }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Measure" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Use the marked pipette for your child's age." }
    ] }
  ],
  "max_blocks": 5,
  "presets": [{ "name": "Dream Drops home steps", "blocks": [{ "type": "step" }, { "type": "step" }, { "type": "step" }] }]
}
{% endschema %}
