{% comment %}
  Parent guide header: loads the Dream Drops fonts for pages that have no product section, shows the
  page title, intro, a small link pill and an optional product card.
  The shared page styling (wavy section edges, white cards, plain FAQ rows, navy closing band) comes
  from the dd-page-style snippet.
{% endcomment %}
{%- assign s = section.settings -%}
{% render 'dd-page-style', heading_font: s.heading_font, body_font: s.body_font %}
<style>
  /* Header */
  #dd-guide-{{ section.id }} { position: relative; overflow: hidden; padding: 64px 0 80px; }
  #dd-guide-{{ section.id }}::before {
    content: ''; position: absolute; left: -60px; top: -60px; width: 220px; height: 220px; border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 255, 255, .75) 0%, rgba(255, 255, 255, .25) 55%, transparent 70%);
  }
  #dd-guide-{{ section.id }} .dd-container { position: relative; }
  #dd-guide-{{ section.id }} .dd-h2 { font-size: 44px; }
  #dd-guide-{{ section.id }} .dd-lede { max-width: 560px; margin: 0 auto; color: #4a5694; }
  #dd-guide-{{ section.id }} .dd-guide__pill {
    display: inline-flex; align-items: center; gap: 6px; margin-top: 26px; padding: 8px 16px; border-radius: 999px;
    background: #fff; border: 1.5px solid #cfe3f3; color: var(--dd-navy); font-weight: 800; font-size: 13px; text-decoration: none;
    box-shadow: 0 4px 12px rgba(43, 58, 143, .08);
  }
  #dd-guide-{{ section.id }} .dd-guide__card {
    display: flex; align-items: center; gap: 22px; max-width: 620px; margin: 28px auto 0; padding: 18px;
    background: #fff; border: 1.5px solid #cfe3f3; border-radius: var(--dd-radius-card); text-align: left;
  }
  #dd-guide-{{ section.id }} .dd-guide__card img { width: 140px; height: 140px; object-fit: cover; border-radius: 12px; flex: none; }
  #dd-guide-{{ section.id }} .dd-guide__card h3 { font-size: 20px; margin: 0 0 6px; }
  #dd-guide-{{ section.id }} .dd-guide__card p { margin: 0 0 14px; color: var(--dd-muted); font-size: 14px; }
  #dd-guide-{{ section.id }} .dd-guide__links { display: flex; flex-wrap: wrap; gap: 10px; }

  @media (max-width: 749px) {
    #dd-guide-{{ section.id }} { padding: 44px 0 60px; }
    #dd-guide-{{ section.id }} .dd-h2 { font-size: 32px; }
    #dd-guide-{{ section.id }} .dd-guide__card { flex-direction: column; text-align: center; }
    #dd-guide-{{ section.id }} .dd-guide__links { justify-content: center; }
  }
</style>
{{ 'dd-product.css' | asset_url | stylesheet_tag }}
{{ 'dd-theme-overrides.css' | asset_url | stylesheet_tag }}

<section class="dd dd-section dd-guide dd-top dd-center" id="dd-guide-{{ section.id }}" style="background: {{ s.background }};">
  <div class="dd-container" style="max-width: {{ s.width }}px;">
    {% render 'dd-heading', s: s %}
    {%- if s.pill_label != blank -%}<a class="dd-guide__pill" href="{{ s.pill_link | default: '#' }}">{{ s.pill_label }}</a>{%- endif -%}
    {%- assign p = s.product -%}
    {%- if p != blank -%}
      <div class="dd-guide__card">
        {%- assign img = s.image | default: p.featured_media.preview_image -%}
        {%- if img -%}{{ img | image_url: width: 400 | image_tag: loading: 'lazy', alt: p.title }}{%- endif -%}
        <div>
          <h3>{{ s.card_title | default: p.title }}</h3>
          {%- if s.card_text != blank -%}<p>{{ s.card_text }}</p>{%- endif -%}
          <div class="dd-guide__links">
            {%- if s.shop_label != blank -%}<a class="dd-btn dd-btn--primary" href="{{ p.url }}">{{ s.shop_label }}</a>{%- endif -%}
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Dream Drops guide header",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow label" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The" },
    { "type": "text", "id": "highlight", "label": "Highlighted words", "default": "Parent Guide" },
    { "type": "text", "id": "heading_after", "label": "Words after highlight" },
    { "type": "richtext", "id": "text", "label": "Intro text" },
    { "type": "text", "id": "pill_label", "label": "Small link label" },
    { "type": "url", "id": "pill_link", "label": "Small link" },
    { "type": "header", "content": "Product card (optional)" },
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "image_picker", "id": "image", "label": "Card image", "info": "Defaults to the product's first image." },
    { "type": "text", "id": "card_title", "label": "Card title" },
    { "type": "text", "id": "card_text", "label": "Card text" },
    { "type": "text", "id": "shop_label", "label": "Shop button label", "default": "Shop Dream Drops" },
    { "type": "header", "content": "Fonts" },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "poppins_n7" },
    { "type": "font_picker", "id": "body_font", "label": "Body font", "default": "nunito_sans_n4" },
    { "type": "header", "content": "Style" },
    { "type": "color_background", "id": "background", "label": "Background", "default": "linear-gradient(180deg, rgba(196, 228, 247, 1) 0%, rgba(222, 240, 251, 1) 100%)" },
    { "type": "range", "id": "width", "label": "Content width", "min": 600, "max": 1400, "step": 20, "unit": "px", "default": 900 }
  ],
  "presets": [{ "name": "Dream Drops guide header" }]
}
{% endschema %}
