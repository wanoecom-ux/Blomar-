{% comment %}
  FAQ accordion. Answers about dosage, safety or medication must be your own, checked wording.
{% endcomment %}
{%- assign s = section.settings -%}
{{ 'dd-product.css' | asset_url | stylesheet_tag }}
<section class="dd dd-section dd-faq" id="dd-faq-{{ section.id }}" style="background: {{ s.background }};{% if s.text_color != blank %} color: {{ s.text_color }};{% endif %}">
  <div class="dd-container" style="max-width: {{ s.width }}px;">
    <div class="dd-cards__head dd-center" style="text-align: {{ s.align }};">{% render 'dd-heading', s: s %}</div>
    <div class="dd-faq__list">
      {%- for block in section.blocks -%}
        <details class="dd-faq__item" {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}<span class="dd-faq__icon" aria-hidden="true">+</span></summary>
          <div class="dd-faq__answer">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
    {%- if s.link_label != blank -%}<div class="dd-center"><a class="dd-link" href="{{ s.link_url | default: '#' }}">{{ s.link_label }}</a></div>{%- endif -%}
  </div>
</section>

{% schema %}
{"name": "Dream Drops FAQ", "tag": "section", "class": "section", "settings": [{"type": "header", "content": "Heading"}, {"type": "text", "id": "eyebrow", "label": "Eyebrow label", "default": "Before you ask"}, {"type": "text", "id": "heading", "label": "Heading", "default": "Questions parents"}, {"type": "text", "id": "highlight", "label": "Highlighted words", "default": "ask"}, {"type": "text", "id": "heading_after", "label": "Words after highlight"}, {"type": "richtext", "id": "text", "label": "Intro text"}, {"type": "header", "content": "Style"}, {"type": "color", "id": "background", "label": "Background", "default": "#ffffff"}, {"type": "color", "id": "text_color", "label": "Text colour"}, {"type": "select", "id": "align", "label": "Heading alignment", "default": "center", "options": [{"value": "left", "label": "Left"}, {"value": "center", "label": "Center"}]}, {"type": "range", "id": "width", "label": "Content width", "min": 600, "max": 1400, "step": 20, "unit": "px", "default": 1100}, {"type": "text", "id": "link_label", "label": "Link label"}, {"type": "url", "id": "link_url", "label": "Link"}], "blocks": [{"type": "question", "name": "Question", "settings": [{"type": "text", "id": "question", "label": "Question", "default": "How much do I give, and when?"}, {"type": "richtext", "id": "answer", "label": "Answer", "default": "<p>REPLACE_ME_ANSWER</p>"}]}], "presets": [{"name": "Dream Drops FAQ", "blocks": [{"type": "question"}]}]}
{% endschema %}
