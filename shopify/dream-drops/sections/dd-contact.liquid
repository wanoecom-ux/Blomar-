{% comment %}
  Contact page: an info column (email, reply time, quick links) beside Shopify's contact form.
  Messages go to the store's sender email set in Settings > Notifications.
{% endcomment %}
{%- assign s = section.settings -%}
{%- assign support_email = s.email | default: shop.email -%}
{{ 'dd-product.css' | asset_url | stylesheet_tag }}
<style>
  #dd-contact-{{ section.id }} .dd-contact__grid { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: 20px; margin-top: 24px; text-align: left; }
  #dd-contact-{{ section.id }} .dd-contact__panel { background: #fff; border-radius: 14px; padding: 26px 24px; box-shadow: 0 6px 18px rgba(43, 58, 143, .08); }
  #dd-contact-{{ section.id }} .dd-contact__item { display: flex; gap: 12px; align-items: flex-start; padding: 12px 0; border-bottom: 1px solid #e3edf7; }
  #dd-contact-{{ section.id }} .dd-contact__item:last-child { border-bottom: 0; }
  #dd-contact-{{ section.id }} .dd-contact__icon { flex: none; width: 36px; height: 36px; border-radius: 50%; background: #fdf2c9; display: grid; place-items: center; font-size: 16px; }
  #dd-contact-{{ section.id }} .dd-contact__item strong { display: block; color: var(--dd-ink); font-size: 14px; }
  #dd-contact-{{ section.id }} .dd-contact__item span, #dd-contact-{{ section.id }} .dd-contact__item a { color: #5a6290; font-size: 13.5px; }
  #dd-contact-{{ section.id }} .dd-contact__item a { text-decoration: underline; text-underline-offset: 2px; }
  #dd-contact-{{ section.id }} .dd-contact__form { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  #dd-contact-{{ section.id }} .dd-contact__form .is-wide { grid-column: 1 / -1; }
  #dd-contact-{{ section.id }} label { display: block; font-size: 12px; font-weight: 700; color: var(--dd-ink); margin-bottom: 5px; }
  #dd-contact-{{ section.id }} :is(input, textarea) {
    width: 100%; box-sizing: border-box; padding: 12px 14px; border: 1.5px solid #d5e3f2; border-radius: 10px; background: #f7fbfe;
    font-size: 14px; color: var(--dd-ink); font-family: var(--dd-font-body);
  }
  #dd-contact-{{ section.id }} :is(input, textarea):focus { outline: none; border-color: var(--dd-navy); background: #fff; }
  #dd-contact-{{ section.id }} textarea { min-height: 130px; resize: vertical; }
  #dd-contact-{{ section.id }} .dd-btn { width: 100%; min-height: 50px; }
  #dd-contact-{{ section.id }} .dd-contact__msg { grid-column: 1 / -1; padding: 12px 14px; border-radius: 10px; font-size: 13.5px; }
  #dd-contact-{{ section.id }} .dd-contact__msg--ok { background: #dcf3e3; color: #1c6b3b; }
  #dd-contact-{{ section.id }} .dd-contact__msg--err { background: #fde3ea; color: #9b2450; }
  @media (max-width: 749px) {
    #dd-contact-{{ section.id }} .dd-contact__grid { grid-template-columns: 1fr; }
    #dd-contact-{{ section.id }} .dd-contact__form { grid-template-columns: 1fr; }
  }
</style>

<section class="dd dd-section dd-contact" style="background: {{ s.background }};">
  <div class="dd-container dd-center" id="dd-contact-{{ section.id }}" style="max-width: {{ s.width }}px;">
    {% render 'dd-heading', s: s %}
    <div class="dd-contact__grid">
      <div class="dd-contact__panel">
        {%- if support_email != blank -%}
          <div class="dd-contact__item"><span class="dd-contact__icon" aria-hidden="true">✉️</span><div><strong>Email</strong><a href="mailto:{{ support_email }}">{{ support_email }}</a></div></div>
        {%- endif -%}
        {%- if s.reply_time != blank -%}
          <div class="dd-contact__item"><span class="dd-contact__icon" aria-hidden="true">⏱️</span><div><strong>Reply time</strong><span>{{ s.reply_time }}</span></div></div>
        {%- endif -%}
        {%- for block in section.blocks -%}
          <div class="dd-contact__item" {{ block.shopify_attributes }}><span class="dd-contact__icon" aria-hidden="true">{{ block.settings.icon }}</span><div><strong>{{ block.settings.title }}</strong>{%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.text }}</a>{%- else -%}<span>{{ block.settings.text }}</span>{%- endif -%}</div></div>
        {%- endfor -%}
      </div>

      <div class="dd-contact__panel">
        {%- assign form_id = 'dd-contact-form-' | append: section.id -%}
        {%- form 'contact', id: form_id, class: 'dd-contact__form' -%}
          {%- if form.posted_successfully? -%}
            <p class="dd-contact__msg dd-contact__msg--ok" role="status">{{ s.success }}</p>
          {%- elsif form.errors -%}
            <p class="dd-contact__msg dd-contact__msg--err" role="alert">{{ form.errors | default_errors }}</p>
          {%- endif -%}
          <div><label for="{{ form_id }}-name">Name</label><input id="{{ form_id }}-name" type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}"></div>
          <div><label for="{{ form_id }}-email">Email *</label><input id="{{ form_id }}-email" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}"></div>
          <div class="is-wide"><label for="{{ form_id }}-order">Order number (if you have one)</label><input id="{{ form_id }}-order" type="text" name="contact[order_number]" value="{{ form.order_number }}"></div>
          <div class="is-wide"><label for="{{ form_id }}-body">Message *</label><textarea id="{{ form_id }}-body" name="contact[body]" required>{{ form.body }}</textarea></div>
          <div class="is-wide"><button type="submit" class="dd-btn dd-btn--accent">{{ s.button_label }}</button></div>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Dream Drops contact",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow label" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get in" },
    { "type": "text", "id": "highlight", "label": "Highlighted words", "default": "touch" },
    { "type": "text", "id": "heading_after", "label": "Words after highlight" },
    { "type": "richtext", "id": "text", "label": "Intro text" },
    { "type": "text", "id": "email", "label": "Support email", "info": "Leave empty to show the store's contact email." },
    { "type": "text", "id": "reply_time", "label": "Reply time", "default": "Usually within 1 business day" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Send message" },
    { "type": "text", "id": "success", "label": "Thank-you message", "default": "Thanks for getting in touch. We'll reply as soon as we can." },
    { "type": "color_background", "id": "background", "label": "Background" },
    { "type": "range", "id": "width", "label": "Content width", "min": 600, "max": 1400, "step": 20, "unit": "px", "default": 960 }
  ],
  "blocks": [
    {
      "type": "info",
      "name": "Info row",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (emoji)", "default": "📦" },
        { "type": "text", "id": "title", "label": "Title", "default": "Track your order" },
        { "type": "text", "id": "text", "label": "Text", "default": "Find your tracking link" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Dream Drops contact" }]
}
{% endschema %}
