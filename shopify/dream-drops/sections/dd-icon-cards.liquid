{% comment %}
  Grid of icon cards. Used twice on the Dream Drops page: the key benefits and the full ingredient list.
{% endcomment %}
{%- assign s = section.settings -%}
{{ 'dd-product.css' | asset_url | stylesheet_tag }}
<section class="dd dd-section dd-cards" id="dd-cards-{{ section.id }}" style="background: {{ s.background }};{% if s.text_color != blank %} color: {{ s.text_color }};{% endif %}">
  <div class="dd-container" style="max-width: {{ s.width }}px;">
    <div class="dd-cards__head" style="text-align: {{ s.align }};">{% render 'dd-heading', s: s %}</div>
    <div class="dd-cards__grid" style="grid-template-columns: repeat({{ s.columns }}, minmax(0, 1fr));{% if s.card_background != blank %} --dd-card-bg: {{ s.card_background }};{% endif %}">
      {%- for block in section.blocks -%}
        <div class="dd-card" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != blank -%}<span class="dd-card__icon" aria-hidden="true">{{ block.settings.icon }}</span>{%- endif -%}
          <div>
            <h3 class="dd-card__title">{{ block.settings.title }}</h3>
            {%- if block.settings.text != blank -%}<p class="dd-card__text">{{ block.settings.text }}</p>{%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
    {%- if s.note != blank -%}<div style="text-align: {{ s.align }};"><span class="dd-note">✓ {{ s.note }}</span></div>{%- endif -%}
    {%- if s.link_label != blank -%}<div style="text-align: center;"><a class="dd-link" href="{{ s.link_url | default: '#' }}">{{ s.link_label }}</a></div>{%- endif -%}
  </div>
</section>

{% schema %}
{"name": "Dream Drops icon cards", "tag": "section", "class": "section", "settings": [{"type": "header", "content": "Heading"}, {"type": "text", "id": "eyebrow", "label": "Eyebrow label", "default": "Strawberry liquid drops"}, {"type": "text", "id": "heading", "label": "Heading", "default": "Magnesium your child will"}, {"type": "text", "id": "highlight", "label": "Highlighted words", "default": "happily take"}, {"type": "text", "id": "heading_after", "label": "Words after highlight"}, {"type": "richtext", "id": "text", "label": "Intro text", "default": "<p>REPLACE_ME_PRODUCT_CLAIM: one or two sentences on why drops are easier than tablets.</p>"}, {"type": "header", "content": "Style"}, {"type": "color_background", "id": "background", "label": "Background", "default": "linear-gradient(180deg, rgba(231, 240, 253, 1) 0%, rgba(255, 255, 255, 1) 100%)"}, {"type": "color", "id": "text_color", "label": "Text colour"}, {"type": "select", "id": "align", "label": "Heading alignment", "default": "left", "options": [{"value": "left", "label": "Left"}, {"value": "center", "label": "Center"}]}, {"type": "range", "id": "width", "label": "Content width", "min": 600, "max": 1400, "step": 20, "unit": "px", "default": 1100}, {"type": "header", "content": "Cards"}, {"type": "range", "id": "columns", "label": "Columns on desktop", "min": 1, "max": 4, "step": 1, "default": 2}, {"type": "color", "id": "card_background", "label": "Card background"}, {"type": "text", "id": "note", "label": "Green note under cards"}, {"type": "text", "id": "link_label", "label": "Link label"}, {"type": "url", "id": "link_url", "label": "Link"}], "blocks": [{"type": "card", "name": "Card", "settings": [{"type": "text", "id": "icon", "label": "Icon (emoji)", "default": "🌙"}, {"type": "text", "id": "title", "label": "Title", "default": "REPLACE_ME_INGREDIENT"}, {"type": "textarea", "id": "text", "label": "Text", "default": "REPLACE_ME_PRODUCT_CLAIM"}]}], "presets": [{"name": "Dream Drops icon cards", "blocks": [{"type": "card"}, {"type": "card"}]}]}
{% endschema %}
