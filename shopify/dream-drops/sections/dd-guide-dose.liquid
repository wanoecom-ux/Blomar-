{% comment %}
  Dosage panel for the parent guide: one white card per age band, a line under the cards, a caution card
  and an optional "other ingredients" list shown as small pills. Dosage wording must match the product label.
{% endcomment %}
{%- assign s = section.settings -%}
{{ 'dd-product.css' | asset_url | stylesheet_tag }}
<style>
  #dd-dose-{{ section.id }} .dd-dose__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; max-width: 520px; margin: 24px auto 0; }
  #dd-dose-{{ section.id }} .dd-dose__card { background: #fff; border: 1.5px solid #d5e3f2; border-radius: 14px; padding: 20px 16px; text-align: center; box-shadow: 0 6px 18px rgba(43, 58, 143, .06); }
  #dd-dose-{{ section.id }} .dd-dose__age { display: block; font-weight: 700; font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: #8d97c9; }
  #dd-dose-{{ section.id }} .dd-dose__amount { display: block; font-family: var(--dd-font-heading) !important; font-weight: 700; font-size: 40px; line-height: 1.1; color: var(--dd-pink); margin: 6px 0 2px; }
  #dd-dose-{{ section.id }} .dd-dose__note { margin: 0; color: var(--dd-ink); font-weight: 700; font-size: 13px; }
  #dd-dose-{{ section.id }} .dd-dose__detail { margin: 10px 0 0; color: #8d97c9; font-size: 12px; line-height: 1.5; }
  #dd-dose-{{ section.id }} .dd-dose__foot { margin: 16px auto 0; color: #8d97c9; font-size: 12.5px; }
  #dd-dose-{{ section.id }} .dd-dose__caution {
    display: flex; gap: 12px; align-items: flex-start; max-width: 520px; margin: 18px auto 0; padding: 16px 18px; border-radius: 14px;
    background: #fff; border: 1.5px solid #d5e3f2; color: #5a6290; text-align: left; font-size: 13px; line-height: 1.55;
  }
  #dd-dose-{{ section.id }} .dd-dose__caution strong { color: var(--dd-ink); }
  #dd-dose-{{ section.id }} .dd-dose__caution p { margin: 0; }
  #dd-dose-{{ section.id }} .dd-dose__caution p + p { margin-top: 4px; }
  #dd-dose-{{ section.id }} .dd-dose__icon { flex: none; width: 30px; height: 30px; border-radius: 50%; background: #fdf2c9; display: grid; place-items: center; font-size: 15px; }
  #dd-dose-{{ section.id }} .dd-dose__other { margin-top: 26px; }
  #dd-dose-{{ section.id }} .dd-dose__other h3 { font-size: 17px; margin: 0 0 10px; }
  #dd-dose-{{ section.id }} .dd-dose__pills { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; }
  #dd-dose-{{ section.id }} .dd-dose__pills li { padding: 6px 12px; border-radius: 999px; background: #fff; border: 1.5px solid #d5e3f2; font-weight: 700; font-size: 12px; color: var(--dd-ink); }
  @media (max-width: 749px) {
    #dd-dose-{{ section.id }} .dd-dose__grid { gap: 10px; }
    #dd-dose-{{ section.id }} .dd-dose__amount { font-size: 34px; }
  }
</style>

<section class="dd dd-section dd-dose" id="{{ s.anchor | default: section.id | handleize }}" style="background: {{ s.background }};">
  <div class="dd-container dd-center" id="dd-dose-{{ section.id }}" style="max-width: {{ s.width }}px;">
    {% render 'dd-heading', s: s %}
    <div class="dd-dose__grid">
      {%- for block in section.blocks -%}
        <div class="dd-dose__card" {{ block.shopify_attributes }}>
          <span class="dd-dose__age">{{ block.settings.age }}</span>
          <span class="dd-dose__amount">{{ block.settings.amount }}</span>
          {%- if block.settings.note != blank -%}<p class="dd-dose__note">{{ block.settings.note }}</p>{%- endif -%}
          {%- if block.settings.detail != blank -%}<p class="dd-dose__detail">{{ block.settings.detail }}</p>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    {%- if s.footnote != blank -%}<p class="dd-dose__foot">{{ s.footnote }}</p>{%- endif -%}
    {%- if s.caution != blank -%}<div class="dd-dose__caution"><span class="dd-dose__icon" aria-hidden="true">⚠️</span><div>{{ s.caution }}</div></div>{%- endif -%}
    {%- if s.other_list != blank -%}
      <div class="dd-dose__other">
        {%- if s.other_title != blank -%}<h3>{{ s.other_title }}</h3>{%- endif -%}
        <ul class="dd-list-reset dd-dose__pills">
          {%- assign items = s.other_list | split: ',' -%}
          {%- for item in items -%}<li>{{ item | strip }}</li>{%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Dream Drops dosage",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor", "default": "dosage", "info": "Buttons can link here with #dosage." },
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow label" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How much to" },
    { "type": "text", "id": "highlight", "label": "Highlighted words", "default": "give" },
    { "type": "text", "id": "heading_after", "label": "Words after highlight" },
    { "type": "richtext", "id": "text", "label": "Intro text" },
    { "type": "text", "id": "footnote", "label": "Line under the cards" },
    { "type": "richtext", "id": "caution", "label": "Caution note" },
    { "type": "text", "id": "other_title", "label": "Other ingredients title", "default": "Other ingredients" },
    { "type": "textarea", "id": "other_list", "label": "Other ingredients", "info": "Separate with commas." },
    { "type": "header", "content": "Style" },
    { "type": "color_background", "id": "background", "label": "Background" },
    { "type": "range", "id": "width", "label": "Content width", "min": 500, "max": 1200, "step": 20, "unit": "px", "default": 760 }
  ],
  "blocks": [
    {
      "type": "band",
      "name": "Age band",
      "settings": [
        { "type": "text", "id": "age", "label": "Age", "default": "Ages 4–7" },
        { "type": "text", "id": "amount", "label": "Amount", "default": "1 ml" },
        { "type": "text", "id": "note", "label": "Frequency", "default": "Once a day" },
        { "type": "text", "id": "detail", "label": "Small print" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Dream Drops dosage", "blocks": [{ "type": "band" }, { "type": "band" }] }]
}
{% endschema %}
