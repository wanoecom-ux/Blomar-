{% comment %}
  Dark band with short time-stamped cards describing the evening routine.
{% endcomment %}
{%- assign s = section.settings -%}
{{ 'dd-product.css' | asset_url | stylesheet_tag }}
<section class="dd dd-section dd-moments" id="dd-moments-{{ section.id }}" style="background: {{ s.background }};{% if s.text_color != blank %} color: {{ s.text_color }};{% endif %}">
  <div class="dd-container" style="max-width: {{ s.width }}px;">
    <div class="dd-cards__head" style="text-align: {{ s.align }};">{% render 'dd-heading', s: s %}</div>
    <div class="dd-moments__grid">
      {%- for block in section.blocks -%}
        <div class="dd-moment" {{ block.shopify_attributes }}>
          <div class="dd-moment__label">{{ block.settings.label }}</div>
          <p class="dd-moment__text">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{"name": "Dream Drops timeline", "tag": "section", "class": "section", "settings": [{"type": "header", "content": "Heading"}, {"type": "text", "id": "eyebrow", "label": "Eyebrow label", "default": "Sound familiar?"}, {"type": "text", "id": "heading", "label": "Heading", "default": "Bedtime shouldn't be"}, {"type": "text", "id": "highlight", "label": "Highlighted words", "default": "a battle"}, {"type": "text", "id": "heading_after", "label": "Words after highlight"}, {"type": "richtext", "id": "text", "label": "Intro text", "default": "<p>How evenings go in a lot of homes.</p>"}, {"type": "header", "content": "Style"}, {"type": "color", "id": "background", "label": "Background", "default": "#2b3a8f"}, {"type": "color", "id": "text_color", "label": "Text colour", "default": "#ffffff"}, {"type": "select", "id": "align", "label": "Heading alignment", "default": "left", "options": [{"value": "left", "label": "Left"}, {"value": "center", "label": "Center"}]}, {"type": "range", "id": "width", "label": "Content width", "min": 600, "max": 1400, "step": 20, "unit": "px", "default": 1100}], "blocks": [{"type": "moment", "name": "Card", "settings": [{"type": "text", "id": "label", "label": "Label", "default": "7:00PM"}, {"type": "textarea", "id": "text", "label": "Text", "default": "Describe this moment."}]}], "max_blocks": 6, "presets": [{"name": "Dream Drops timeline", "blocks": [{"type": "moment"}, {"type": "moment"}, {"type": "moment"}]}]}
{% endschema %}
