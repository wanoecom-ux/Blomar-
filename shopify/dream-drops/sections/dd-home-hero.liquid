{% comment %}
  Home page top section, stacked in one narrow column: eyebrow tag, headline, sub-line, an optional proof line,
  tick list, button, note and text link, then a large image card and a row of small feature chips.
  Loads the shared page styling, so it should be the first content section on the page.
{% endcomment %}
{%- assign s = section.settings -%}
{% render 'dd-page-style', heading_font: s.heading_font, body_font: s.body_font %}
{{ 'dd-product.css' | asset_url | stylesheet_tag }}
{{ 'dd-theme-overrides.css' | asset_url | stylesheet_tag }}
<style>
  #dd-hh-{{ section.id }} { padding: 48px 0 64px; }
  #dd-hh-{{ section.id }} .dd-hh__col { max-width: {{ s.width }}px; margin: 0 auto; }
  #dd-hh-{{ section.id }} h1 {
    font-family: var(--dd-font-heading) !important; font-size: 44px; line-height: 1.12; margin: 4px 0 14px;
    color: var(--dd-ink) !important; letter-spacing: -.02em !important;
  }
  #dd-hh-{{ section.id }} h1 .dd-hl { color: var(--dd-pink); }
  #dd-hh-{{ section.id }} .dd-hh__sub { margin: 0 0 16px; color: #4a5694; font-size: 16px; line-height: 1.65; }
  #dd-hh-{{ section.id }} .dd-hh__proof { margin: 0 0 12px; color: var(--dd-ink); font-size: 14px; font-weight: 700; }
  #dd-hh-{{ section.id }} .dd-hh__ticks { display: grid; gap: 8px; margin: 0 0 22px; }
  #dd-hh-{{ section.id }} .dd-hh__ticks li { display: flex; gap: 10px; align-items: flex-start; color: #26306a; font-size: 14px; font-weight: 700; line-height: 1.45; }
  #dd-hh-{{ section.id }} .dd-hh__ticks li::before {
    content: '✓'; flex: none; width: 18px; height: 18px; margin-top: 1px; border-radius: 50%; display: grid; place-items: center;
    background: var(--dd-pink); color: #fff; font-size: 10px; font-weight: 900;
  }
  #dd-hh-{{ section.id }} .dd-hh__cta { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 30px; text-decoration: none; font-size: 15px !important; }
  #dd-hh-{{ section.id }} .dd-hh__note { margin: 12px 0 0; color: #8d97c9; font-size: 12.5px; font-weight: 600; }
  #dd-hh-{{ section.id }} .dd-hh__link { display: inline-block; margin-top: 12px; color: #6a78c2 !important; font-size: 13px; font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }
  #dd-hh-{{ section.id }} .dd-hh__media { margin-top: 26px; }
  #dd-hh-{{ section.id }} .dd-hh__media img { display: block; width: 100%; height: auto; border-radius: 18px; box-shadow: 0 18px 40px rgba(43, 58, 143, .16); }
  #dd-hh-{{ section.id }} .dd-hh__chips { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-top: 16px; }
  #dd-hh-{{ section.id }} .dd-hh__chips li {
    padding: 7px 14px; border-radius: 999px; background: #fff; border: 1px solid #dfe3f3;
    color: var(--dd-ink); font-size: 12px; font-weight: 800; box-shadow: 0 2px 6px rgba(43, 58, 143, .05);
  }
  @media (max-width: 749px) {
    #dd-hh-{{ section.id }} { padding: 26px 0 48px; }
    #dd-hh-{{ section.id }} h1 { font-size: 34px; }
    #dd-hh-{{ section.id }} .dd-hh__sub { font-size: 16px; }
    #dd-hh-{{ section.id }} .dd-hh__ticks li { font-size: 15px; }
    #dd-hh-{{ section.id }} .dd-hh__ticks li::before { width: 20px; height: 20px; }
    #dd-hh-{{ section.id }} .dd-hh__cta { width: 100%; min-height: 64px; font-size: 18px !important; }
    #dd-hh-{{ section.id }} .dd-hh__note { font-size: 14px; }
    #dd-hh-{{ section.id }} .dd-hh__link { font-size: 14px; line-height: 1.8; }
    #dd-hh-{{ section.id }} .dd-hh__chips { gap: 10px; }
    #dd-hh-{{ section.id }} .dd-hh__chips li { font-size: 13px; padding: 9px 16px; }
  }
</style>

<section class="dd dd-section dd-top dd-hh" id="dd-hh-{{ section.id }}" style="background: {{ s.background }};">
  <div class="dd-container">
    <div class="dd-hh__col">
      {%- if s.eyebrow != blank -%}<span class="dd-eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
      <h1>{{ s.heading }}{% if s.highlight != blank %} <span class="dd-hl">{{ s.highlight }}</span>{% endif %}</h1>
      {%- if s.sub != blank -%}<p class="dd-hh__sub">{{ s.sub }}</p>{%- endif -%}
      {%- if s.proof != blank -%}<p class="dd-hh__proof">{{ s.proof }}</p>{%- endif -%}
      {%- if s.ticks != blank -%}
        <ul class="dd-list-reset dd-hh__ticks">
          {%- assign lines = s.ticks | newline_to_br | split: '<br />' -%}
          {%- for line in lines -%}{%- assign l = line | strip -%}{%- if l != blank -%}<li>{{ l }}</li>{%- endif -%}{%- endfor -%}
        </ul>
      {%- endif -%}
      {%- assign url = s.button_link | default: s.product.url -%}
      {%- if s.button_label != blank -%}<a class="dd-btn dd-btn--accent dd-hh__cta" href="{{ url }}">{{ s.button_label }}</a>{%- endif -%}
      {%- if s.note != blank -%}<p class="dd-hh__note">{{ s.note }}</p>{%- endif -%}
      {%- if s.link_label != blank -%}<div><a class="dd-hh__link" href="{{ s.link_url | default: '#' }}">{{ s.link_label }}</a></div>{%- endif -%}

      {%- assign img = s.image | default: s.product.featured_media.preview_image -%}
      {%- if img -%}
        <div class="dd-hh__media">
          <a href="{{ url }}" tabindex="-1">{{ img | image_url: width: 1200 | image_tag: loading: 'eager', alt: s.product.title | default: s.heading, widths: '400, 700, 1000, 1200', sizes: '(min-width: 750px) 620px, 100vw' }}</a>
        </div>
      {%- endif -%}
      {%- if s.chips != blank -%}
        <ul class="dd-list-reset dd-hh__chips">
          {%- assign items = s.chips | split: ',' -%}
          {%- for item in items -%}{%- assign t = item | strip -%}{%- if t != blank -%}<li>{{ t }}</li>{%- endif -%}{%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Dream Drops home hero",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow tag" },
    { "type": "text", "id": "heading", "label": "Headline", "default": "Evenings," },
    { "type": "text", "id": "highlight", "label": "Highlighted words", "default": "made easier." },
    { "type": "textarea", "id": "sub", "label": "Sub-line" },
    { "type": "text", "id": "proof", "label": "Proof line", "info": "Only use real, checkable numbers." },
    { "type": "textarea", "id": "ticks", "label": "Tick list (one per line)" },
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Try Dream Drops" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Leave empty to go to the product." },
    { "type": "text", "id": "note", "label": "Note under button" },
    { "type": "text", "id": "link_label", "label": "Text link label" },
    { "type": "url", "id": "link_url", "label": "Text link" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Defaults to the product's first image." },
    { "type": "text", "id": "chips", "label": "Chips under the image (comma separated)" },
    { "type": "header", "content": "Fonts" },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "poppins_n7" },
    { "type": "font_picker", "id": "body_font", "label": "Body font", "default": "nunito_sans_n4" },
    { "type": "header", "content": "Style" },
    { "type": "color_background", "id": "background", "label": "Background", "default": "linear-gradient(180deg, rgba(227, 230, 247, 1) 0%, rgba(239, 231, 239, 1) 60%, rgba(246, 233, 228, 1) 100%)" },
    { "type": "range", "id": "width", "label": "Column width", "min": 480, "max": 900, "step": 20, "unit": "px", "default": 620 }
  ],
  "presets": [{ "name": "Dream Drops home hero" }]
}
{% endschema %}
