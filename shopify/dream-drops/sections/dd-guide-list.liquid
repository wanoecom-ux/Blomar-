{% comment %}
  Parent guide "other ingredients" panel: heading, a white box listing the rest of the formula, and a row of small
  feature pills. The ingredient list must match the product label.
{% endcomment %}
{%- assign s = section.settings -%}
{{ 'dd-product.css' | asset_url | stylesheet_tag }}
<style>
  #dd-list-{{ section.id }} .dd-list__box {
    margin-top: 18px; padding: 16px 18px; background: #fff; border: 1.5px solid #d5e3f2; border-radius: 12px;
    color: #5a6290; font-size: 13.5px; line-height: 1.6; text-align: left;
  }
  #dd-list-{{ section.id }} .dd-list__box p { margin: 0; }
  #dd-list-{{ section.id }} .dd-list__pills { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
  #dd-list-{{ section.id }} .dd-list__pills li {
    padding: 6px 12px; border-radius: 999px; background: #fff; border: 1.5px solid #d5e3f2;
    font-weight: 700; font-size: 12px; color: var(--dd-ink);
  }
</style>

<section class="dd dd-section dd-guide-list" style="background: {{ s.background }};">
  <div class="dd-container" id="dd-list-{{ section.id }}" style="max-width: {{ s.width }}px; text-align: {{ s.align }};">
    {% render 'dd-heading', s: s %}
    {%- if s.list != blank -%}<div class="dd-list__box">{{ s.list }}</div>{%- endif -%}
    {%- if s.pills != blank -%}
      <ul class="dd-list-reset dd-list__pills"{% if s.align == 'center' %} style="justify-content: center;"{% endif %}>
        {%- assign items = s.pills | split: ',' -%}
        {%- for item in items -%}<li>{{ item | strip }}</li>{%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Dream Drops guide list",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow label" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What else is in" },
    { "type": "text", "id": "highlight", "label": "Highlighted words", "default": "the bottle?" },
    { "type": "text", "id": "heading_after", "label": "Words after highlight" },
    { "type": "richtext", "id": "text", "label": "Intro text" },
    { "type": "richtext", "id": "list", "label": "Ingredient list" },
    { "type": "text", "id": "pills", "label": "Feature pills", "info": "Separate with commas." },
    { "type": "select", "id": "align", "label": "Alignment", "default": "left", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }] },
    { "type": "color_background", "id": "background", "label": "Background" },
    { "type": "range", "id": "width", "label": "Content width", "min": 500, "max": 1200, "step": 20, "unit": "px", "default": 760 }
  ],
  "presets": [{ "name": "Dream Drops guide list" }]
}
{% endschema %}
