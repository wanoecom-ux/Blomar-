{% comment %}
  Pre-lander hero: headline, sub-line, tick list, a button to the product, an optional proof line,
  a product image and small feature badges, plus a text link (e.g. to the Parent Guide).
  Loads the shared page styling, so it should be the first content section on the page.
{% endcomment %}
{%- assign s = section.settings -%}
{% render 'dd-page-style', heading_font: s.heading_font, body_font: s.body_font %}
{{ 'dd-product.css' | asset_url | stylesheet_tag }}
{{ 'dd-theme-overrides.css' | asset_url | stylesheet_tag }}
<style>
  #dd-pre-{{ section.id }} { position: relative; overflow: hidden; padding: 56px 0 76px; }
  #dd-pre-{{ section.id }} .dd-pre__grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); gap: 40px; align-items: center; }
  #dd-pre-{{ section.id }} h1 { font-family: var(--dd-font-heading) !important; font-size: 46px; line-height: 1.1; margin: 0 0 14px; color: var(--dd-ink); }
  #dd-pre-{{ section.id }} h1 .dd-hl { color: var(--dd-pink); }
  #dd-pre-{{ section.id }} .dd-pre__sub { color: #4a5694; font-size: 17px; line-height: 1.55; margin: 0 0 18px; }
  #dd-pre-{{ section.id }} .dd-pre__ticks { display: grid; gap: 10px; margin: 0 0 24px; }
  #dd-pre-{{ section.id }} .dd-pre__ticks li { display: flex; gap: 10px; align-items: flex-start; font-weight: 700; color: var(--dd-ink); font-size: 15px; }
  #dd-pre-{{ section.id }} .dd-pre__ticks li::before {
    content: '✓'; flex: none; width: 22px; height: 22px; border-radius: 50%; display: grid; place-items: center;
    background: var(--dd-pink); color: #fff; font-size: 12px; margin-top: 1px;
  }
  #dd-pre-{{ section.id }} .dd-pre__cta { display: inline-flex; align-items: center; justify-content: center; min-height: 56px; padding: 0 34px; text-decoration: none; font-size: 18px !important; box-shadow: 0 8px 22px rgba(233, 72, 139, .35); }
  #dd-pre-{{ section.id }} .dd-pre__note { margin: 12px 0 0; font-size: 13px; color: #5a6290; }
  #dd-pre-{{ section.id }} .dd-pre__proof { margin: 14px 0 0; font-size: 14px; font-weight: 700; color: var(--dd-ink); }
  #dd-pre-{{ section.id }} .dd-pre__link { display: inline-block; margin-top: 16px; color: #6a78c2; font-weight: 800; text-decoration: underline; text-underline-offset: 3px; }
  #dd-pre-{{ section.id }} .dd-pre__media img { width: 100%; height: auto; border-radius: 20px; box-shadow: 0 18px 40px rgba(43, 58, 143, .18); }
  #dd-pre-{{ section.id }} .dd-pre__badges { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; margin-top: 16px; }
  #dd-pre-{{ section.id }} .dd-pre__badges li { padding: 6px 12px; border-radius: 999px; background: #fff; border: 1.5px solid #d5e3f2; font-weight: 700; font-size: 12px; color: var(--dd-ink); }
  @media (max-width: 749px) {
    #dd-pre-{{ section.id }} { padding: 32px 0 56px; }
    #dd-pre-{{ section.id }} .dd-pre__grid { grid-template-columns: 1fr; gap: 24px; text-align: center; }
    #dd-pre-{{ section.id }} .dd-pre__media { order: -1; }
    #dd-pre-{{ section.id }} h1 { font-size: 32px; }
    #dd-pre-{{ section.id }} .dd-pre__sub { font-size: 15.5px; }
    #dd-pre-{{ section.id }} .dd-pre__ticks { text-align: left; max-width: 340px; margin-left: auto; margin-right: auto; }
    #dd-pre-{{ section.id }} .dd-pre__cta { width: 100%; }
  }
</style>

<section class="dd dd-section dd-top dd-pre" id="dd-pre-{{ section.id }}" style="background: {{ s.background }};">
  <div class="dd-container" style="max-width: {{ s.width }}px;">
    <div class="dd-pre__grid">
      <div>
        {%- if s.eyebrow != blank -%}<span class="dd-eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
        <h1>{{ s.heading }}{% if s.highlight != blank %} <span class="dd-hl">{{ s.highlight }}</span>{% endif %}</h1>
        {%- if s.sub != blank -%}<p class="dd-pre__sub">{{ s.sub }}</p>{%- endif -%}
        {%- if s.ticks != blank -%}
          <ul class="dd-list-reset dd-pre__ticks">
            {%- assign lines = s.ticks | newline_to_br | split: '<br />' -%}
            {%- for line in lines -%}{%- assign l = line | strip -%}{%- if l != blank -%}<li>{{ l }}</li>{%- endif -%}{%- endfor -%}
          </ul>
        {%- endif -%}
        {%- assign url = s.button_link | default: s.product.url -%}
        {%- if s.button_label != blank -%}<a class="dd-btn dd-btn--accent dd-pre__cta" href="{{ url }}">{{ s.button_label }}</a>{%- endif -%}
        {%- if s.note != blank -%}<p class="dd-pre__note">{{ s.note }}</p>{%- endif -%}
        {%- if s.proof != blank -%}<p class="dd-pre__proof">{{ s.proof }}</p>{%- endif -%}
        {%- if s.link_label != blank -%}<div><a class="dd-pre__link" href="{{ s.link_url | default: '#' }}">{{ s.link_label }}</a></div>{%- endif -%}
      </div>
      <div class="dd-pre__media">
        {%- assign img = s.image | default: s.product.featured_media.preview_image -%}
        {%- if img -%}{{ img | image_url: width: 1000 | image_tag: loading: 'eager', alt: s.product.title | default: s.heading, widths: '400, 700, 1000' }}{%- endif -%}
        {%- if s.badges != blank -%}
          <ul class="dd-list-reset dd-pre__badges">
            {%- assign items = s.badges | split: ',' -%}
            {%- for item in items -%}<li>{{ item | strip }}</li>{%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Dream Drops pre-lander",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow label" },
    { "type": "text", "id": "heading", "label": "Headline", "default": "Bedtime, without" },
    { "type": "text", "id": "highlight", "label": "Highlighted words", "default": "the battle" },
    { "type": "textarea", "id": "sub", "label": "Sub-line" },
    { "type": "textarea", "id": "ticks", "label": "Tick list (one per line)" },
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Try Dream Drops" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Leave empty to go to the product." },
    { "type": "text", "id": "note", "label": "Note under button" },
    { "type": "text", "id": "proof", "label": "Proof line", "info": "Only use real, checkable numbers." },
    { "type": "text", "id": "link_label", "label": "Text link label" },
    { "type": "url", "id": "link_url", "label": "Text link" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Defaults to the product's first image." },
    { "type": "text", "id": "badges", "label": "Badges (comma separated)" },
    { "type": "header", "content": "Fonts" },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "poppins_n7" },
    { "type": "font_picker", "id": "body_font", "label": "Body font", "default": "nunito_sans_n4" },
    { "type": "header", "content": "Style" },
    { "type": "color_background", "id": "background", "label": "Background", "default": "linear-gradient(180deg, rgba(196, 228, 247, 1) 0%, rgba(222, 240, 251, 1) 100%)" },
    { "type": "range", "id": "width", "label": "Content width", "min": 700, "max": 1400, "step": 20, "unit": "px", "default": 1100 }
  ],
  "presets": [{ "name": "Dream Drops pre-lander" }]
}
{% endschema %}
