{% comment %}
  Key-figure strip: up to four tiles (big figure + label), a button and a small note.
  Only use figures you can stand behind (bottle size, guarantee length, real review counts).
{% endcomment %}
{%- assign s = section.settings -%}
{{ 'dd-product.css' | asset_url | stylesheet_tag }}
<style>
  #dd-stats-{{ section.id }} .dd-stats__grid { display: grid; grid-template-columns: repeat({{ section.blocks.size | at_least: 1 }}, minmax(0, 1fr)); gap: 16px; margin: 24px 0; }
  #dd-stats-{{ section.id }} .dd-stats__tile { background: #fff; border: 1px solid #e3e8f6; border-radius: 14px; padding: 18px 12px; box-shadow: 0 4px 14px rgba(43, 58, 143, .06); }
  #dd-stats-{{ section.id }} .dd-stats__fig { display: block; font-family: var(--dd-font-heading) !important; font-weight: 700; font-size: 34px; line-height: 1.1; color: var(--dd-pink); }
  #dd-stats-{{ section.id }} .dd-stats__label { display: block; margin-top: 6px; color: #5a6290; font-size: 13.5px; font-weight: 700; }
  #dd-stats-{{ section.id }} .dd-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 54px; padding: 0 32px; text-decoration: none; }
  #dd-stats-{{ section.id }} .dd-stats__note { margin: 10px 0 0; color: #5a6290; font-size: 13px; }
  @media (max-width: 749px) {
    #dd-stats-{{ section.id }} .dd-stats__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    #dd-stats-{{ section.id }} .dd-stats__fig { font-size: 26px; }
    #dd-stats-{{ section.id }} .dd-stats__label { font-size: 12.5px; }
    #dd-stats-{{ section.id }} .dd-btn { width: 100%; }
  }
</style>

<section class="dd dd-section dd-stats" style="background: {{ s.background }};">
  <div class="dd-container dd-center" id="dd-stats-{{ section.id }}" style="max-width: {{ s.width }}px;">
    {% render 'dd-heading', s: s %}
    <div class="dd-stats__grid">
      {%- for block in section.blocks -%}
        <div class="dd-stats__tile" {{ block.shopify_attributes }}>
          <span class="dd-stats__fig">{{ block.settings.figure }}</span>
          <span class="dd-stats__label">{{ block.settings.label }}</span>
        </div>
      {%- endfor -%}
    </div>
    {%- if s.button_label != blank -%}<a class="dd-btn dd-btn--accent" href="{{ s.button_link | default: '#' }}">{{ s.button_label }}</a>{%- endif -%}
    {%- if s.note != blank -%}<p class="dd-stats__note">{{ s.note }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Dream Drops key figures",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow label" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "highlight", "label": "Highlighted words" },
    { "type": "text", "id": "heading_after", "label": "Words after highlight" },
    { "type": "richtext", "id": "text", "label": "Intro text" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Get Dream Drops" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "note", "label": "Note under button" },
    { "type": "color_background", "id": "background", "label": "Background" },
    { "type": "range", "id": "width", "label": "Content width", "min": 600, "max": 1400, "step": 20, "unit": "px", "default": 900 }
  ],
  "blocks": [
    { "type": "tile", "name": "Figure", "settings": [
      { "type": "text", "id": "figure", "label": "Figure", "default": "60 ml" },
      { "type": "text", "id": "label", "label": "Label", "default": "Up to 60 days per bottle" }
    ] }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Dream Drops key figures", "blocks": [{ "type": "tile" }, { "type": "tile" }, { "type": "tile" }] }]
}
{% endschema %}
