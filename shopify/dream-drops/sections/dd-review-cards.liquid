{% comment %}
  Review cards: eyebrow tag, heading, then a row of white cards (stars, title, quote, initials circle,
  name, detail line, optional "Verified Purchase"). Add one block per review in the theme editor.
  A block with no quote is an empty slot: it shows as a dashed placeholder in the editor only, and the
  whole section stays hidden on the storefront until at least one review has a quote.
{% endcomment %}
{%- assign s = section.settings -%}
{%- assign filled = 0 -%}
{%- for block in section.blocks -%}{%- if block.settings.body != blank -%}{%- assign filled = filled | plus: 1 -%}{%- endif -%}{%- endfor -%}
{%- if filled > 0 or request.design_mode -%}
{{ 'dd-product.css' | asset_url | stylesheet_tag }}
<style>
  #dd-rc-{{ section.id }} .dd-h2 { font-size: 34px; color: var(--dd-ink) !important; }
  #dd-rc-{{ section.id }} .dd-rc__grid { display: grid; grid-template-columns: repeat({{ s.columns }}, minmax(0, 1fr)); gap: 20px; margin-top: 30px; text-align: left; }
  #dd-rc-{{ section.id }} .dd-rc__card {
    display: flex; flex-direction: column; padding: 26px 26px 24px; background: #fff; border: 1px solid #dbe7f3;
    border-radius: 18px; box-shadow: 0 6px 18px rgba(43, 58, 143, .06);
  }
  #dd-rc-{{ section.id }} .dd-rc__stars { color: #f2b200; font-size: 18px; letter-spacing: 2px; line-height: 1; }
  #dd-rc-{{ section.id }} .dd-rc__title { margin: 16px 0 12px; font-size: 15px; font-weight: 800 !important; color: var(--dd-ink) !important; letter-spacing: .02em !important; }
  #dd-rc-{{ section.id }} .dd-rc__body { margin: 0; flex: 1; color: #3f4c96; font-size: 13.5px; line-height: 1.75; font-style: italic; letter-spacing: .02em; }
  #dd-rc-{{ section.id }} .dd-rc__foot { display: flex; gap: 12px; align-items: center; margin-top: 16px; padding-top: 18px; border-top: 1px solid #e3e8ef; }
  #dd-rc-{{ section.id }} .dd-rc__avatar { flex: none; width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; color: #fff; font-weight: 800 !important; font-size: 14px; letter-spacing: .04em; }
  #dd-rc-{{ section.id }} .dd-rc__name { display: block; font-weight: 800 !important; font-size: 13.5px; color: var(--dd-ink); letter-spacing: .02em; }
  #dd-rc-{{ section.id }} .dd-rc__detail { display: block; margin-top: 2px; font-size: 12px; color: #7d89c4; letter-spacing: .03em; }
  #dd-rc-{{ section.id }} .dd-rc__verified { display: block; margin-top: 4px; font-size: 11.5px; font-weight: 800 !important; color: #2f9a50; letter-spacing: .03em; }
  #dd-rc-{{ section.id }} .dd-rc__card--empty { border: 2px dashed #b9c8f0; background: rgba(255, 255, 255, .55); box-shadow: none; justify-content: center; align-items: center; text-align: center; min-height: 220px; color: #6a78c2; font-size: 13px; font-weight: 700; }
  @media (max-width: 989px) {
    #dd-rc-{{ section.id }} .dd-rc__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 749px) {
    #dd-rc-{{ section.id }} .dd-h2 { font-size: 28px; }
    #dd-rc-{{ section.id }} .dd-rc__grid { grid-template-columns: 1fr; gap: 14px; }
    #dd-rc-{{ section.id }} .dd-rc__card { padding: 22px 20px; }
    #dd-rc-{{ section.id }} .dd-rc__body { font-size: 14.5px; }
  }
</style>

<section class="dd dd-section dd-rc" id="dd-rc-{{ section.id }}" style="background: {{ s.background }};">
  <div class="dd-container dd-center" style="max-width: {{ s.width }}px;">
    {% render 'dd-heading', s: s %}
    <div class="dd-rc__grid">
      {%- assign colours = s.avatar_colours | split: ',' -%}
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        {%- if b.body != blank -%}
          {%- assign initials = '' -%}
          {%- assign words = b.name | split: ' ' -%}
          {%- for w in words limit: 2 -%}{%- assign letter = w | slice: 0 | upcase -%}{%- assign initials = initials | append: letter -%}{%- endfor -%}
          {%- assign ci = forloop.index0 | modulo: colours.size -%}
          <article class="dd-rc__card" {{ block.shopify_attributes }}>
            <div class="dd-rc__stars" aria-label="{{ b.stars }} out of 5 stars">{% for i in (1..b.stars) %}★{% endfor %}</div>
            {%- if b.title != blank -%}<h3 class="dd-rc__title">{{ b.title }}</h3>{%- endif -%}
            <p class="dd-rc__body">"{{ b.body }}"</p>
            <div class="dd-rc__foot">
              <span class="dd-rc__avatar" style="background: {{ colours[ci] | strip | default: '#5b63c9' }};" aria-hidden="true">{{ initials }}</span>
              <div>
                <span class="dd-rc__name">{{ b.name }}</span>
                {%- if b.detail != blank -%}<span class="dd-rc__detail">{{ b.detail }}</span>{%- endif -%}
                {%- if b.verified -%}<span class="dd-rc__verified">✔ Verified Purchase</span>{%- endif -%}
              </div>
            </div>
          </article>
        {%- elsif request.design_mode -%}
          <div class="dd-rc__card dd-rc__card--empty" {{ block.shopify_attributes }}>Empty review box<br>Click to add a review (only shows here in the editor)</div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Dream Drops review cards",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow tag", "default": "Reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What parents" },
    { "type": "text", "id": "highlight", "label": "Highlighted words", "default": "are saying" },
    { "type": "text", "id": "heading_after", "label": "Words after highlight" },
    { "type": "richtext", "id": "text", "label": "Intro text" },
    { "type": "select", "id": "columns", "label": "Cards per row (desktop)", "default": "3", "options": [{ "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }] },
    { "type": "text", "id": "avatar_colours", "label": "Initials circle colours (comma separated)", "default": "#5b6cc4, #2f3f8f, #2f9a50, #d15b88" },
    { "type": "color_background", "id": "background", "label": "Background", "default": "#e3f3fb" },
    { "type": "range", "id": "width", "label": "Content width", "min": 700, "max": 1400, "step": 20, "unit": "px", "default": 1120 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "stars", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "body", "label": "Review text", "info": "Leave empty to keep this box hidden on the live site." },
        { "type": "text", "id": "name", "label": "Name", "info": "e.g. first name and last initial. The initials circle is made from this." },
        { "type": "text", "id": "detail", "label": "Detail line", "info": "e.g. Parent of a 7-year-old · Town" },
        { "type": "checkbox", "id": "verified", "label": "Show \"Verified Purchase\"", "default": false, "info": "Only tick this for a customer who bought from this store." }
      ]
    }
  ],
  "presets": [{ "name": "Dream Drops review cards", "blocks": [{ "type": "review" }, { "type": "review" }, { "type": "review" }] }]
}
{% endschema %}
