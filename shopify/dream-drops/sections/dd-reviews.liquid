{% comment %}
  Reviews grid with tag filters and load more. Holds placeholder cards until real reviews are added.
{% endcomment %}
{%- assign s = section.settings -%}
{{ 'dd-product.css' | asset_url | stylesheet_tag }}
<section class="dd dd-section dd-reviews dd-center" id="dd-reviews"{% if s.background != blank %} style="background: {{ s.background }};"{% endif %}>
  <div class="dd-container" style="max-width: {{ s.width }}px;" data-dd-reviews data-step="{{ s.per_page }}">
    {% render 'dd-heading', s: s %}
    {%- if s.show_summary -%}
      <div class="dd-reviews__summary">
        <span class="dd-stars" aria-hidden="true">★★★★★</span>
        <span class="dd-reviews__score">{{ s.score }}</span>
        <span class="dd-reviews__count">{{ s.count }}</span>
      </div>
    {%- endif -%}
    {%- assign tags = s.filters | split: ',' -%}
    {%- if tags.size > 0 -%}
      <div class="dd-reviews__filters" role="group" aria-label="Filter reviews">
        <button type="button" class="dd-reviews__filter" data-dd-filter="all" aria-pressed="true">All reviews</button>
        {%- for t in tags -%}
          {%- assign key = t | strip | handleize -%}
          <button type="button" class="dd-reviews__filter" data-dd-filter="{{ key }}" aria-pressed="false">{{ t | strip }}</button>
        {%- endfor -%}
      </div>
    {%- endif -%}
    <div class="dd-reviews__grid">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <article class="dd-review{% if forloop.index <= 3 %} is-featured{% endif %}" data-dd-review data-tag="{{ b.tag | handleize }}" {{ block.shopify_attributes }}>
          <div class="dd-review__top"><span class="dd-stars" aria-label="{{ b.stars }} out of 5 stars">{% for i in (1..b.stars) %}★{% endfor %}</span><span>{{ b.date }}</span></div>
          {%- if b.tag != blank -%}<span class="dd-review__tag">{{ b.tag }}</span>{%- endif -%}
          <h3 class="dd-review__title">{{ b.title }}</h3>
          <p class="dd-review__body">“{{ b.body }}”</p>
          <div class="dd-review__author">
            <span class="dd-review__avatar" aria-hidden="true">{{ b.name | slice: 0 }}</span>
            <span><strong>{{ b.name }}</strong><br>{{ b.detail }}{% if b.verified %}<br><span class="dd-review__verified">✔ Verified purchase</span>{% endif %}</span>
          </div>
        </article>
      {%- endfor -%}
    </div>
    <button type="button" class="dd-btn dd-reviews__more" data-dd-more>{{ s.more_label }}</button>
    <p class="dd-reviews__shown" data-dd-shown aria-live="polite"></p>
  </div>
</section>

{% schema %}
{"name": "Dream Drops reviews", "tag": "section", "class": "section", "settings": [{"type": "header", "content": "Heading"}, {"type": "text", "id": "eyebrow", "label": "Eyebrow label"}, {"type": "text", "id": "heading", "label": "Heading", "default": "What"}, {"type": "text", "id": "highlight", "label": "Highlighted words", "default": "parents"}, {"type": "text", "id": "heading_after", "label": "Words after highlight", "default": "are saying"}, {"type": "richtext", "id": "text", "label": "Intro text", "default": "<p>REPLACE_ME: only publish reviews from real customers.</p>"}, {"type": "header", "content": "Summary"}, {"type": "checkbox", "id": "show_summary", "label": "Show rating summary", "default": true}, {"type": "text", "id": "score", "label": "Average score", "default": "REPLACE_ME_RATING"}, {"type": "text", "id": "count", "label": "Count text", "default": "REPLACE_ME_REVIEW_COUNT reviews"}, {"type": "text", "id": "filters", "label": "Filter tags (comma separated)", "default": "Bedtime, Calm, Flavour, Easy to take", "info": "Match each review's tag to one of these."}, {"type": "range", "id": "per_page", "label": "Reviews shown at first", "min": 3, "max": 12, "step": 3, "default": 6}, {"type": "text", "id": "more_label", "label": "Load more label", "default": "Load more reviews"}, {"type": "color_background", "id": "background", "label": "Background"}, {"type": "range", "id": "width", "label": "Content width", "min": 600, "max": 1400, "step": 20, "unit": "px", "default": 1100}], "blocks": [{"type": "review", "name": "Review", "settings": [{"type": "paragraph", "content": "Add genuine reviews only. If you use a reviews app, remove this section and add the app block instead."}, {"type": "range", "id": "stars", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5}, {"type": "text", "id": "date", "label": "Date"}, {"type": "text", "id": "tag", "label": "Tag", "default": "Bedtime"}, {"type": "text", "id": "title", "label": "Title", "default": "REPLACE_ME_REVIEW"}, {"type": "textarea", "id": "body", "label": "Review", "default": "REPLACE_ME_REVIEW"}, {"type": "text", "id": "name", "label": "Name", "default": "REPLACE_ME"}, {"type": "text", "id": "detail", "label": "Detail line", "default": "Parent"}, {"type": "checkbox", "id": "verified", "label": "Verified purchase", "default": false}]}], "presets": [{"name": "Dream Drops reviews", "blocks": [{"type": "review"}]}]}
{% endschema %}
