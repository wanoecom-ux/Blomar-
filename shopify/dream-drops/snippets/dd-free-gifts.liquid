{% comment %}
  Free gifts row for the buy box: a heading, then a free shipping tile and one tile per gift product.
  Gift products are found by handle (section settings), so they can stay Unlisted in admin.
  Each tile's "FREE £x" pill uses the value set in the section, or the gift's compare-at price.
  When auto-add is on, dd-product.js adds the gift products to the cart along with Dream Drops.
  Pass `s` (section.settings).
{% endcomment %}
{%- liquid
  assign gifts = ''
  if s.gift_1_handle != blank and all_products[s.gift_1_handle].id
    assign gifts = gifts | append: s.gift_1_handle | append: ','
  endif
  if s.gift_2_handle != blank and all_products[s.gift_2_handle].id
    assign gifts = gifts | append: s.gift_2_handle | append: ','
  endif
  assign gift_handles = gifts | split: ','
-%}
<style>
  .dd-gifts { text-align: center; }
  .dd-info :is(.dd-gifts, #dd-x) { margin-top: -14px !important; }
  .dd-gifts :is(.dd-gifts__title, #dd-x) { margin: 0 0 4px !important; }
  .dd-gifts__title {
    margin: 0 0 19px; font-family: var(--dd-font-heading) !important; font-weight: 800 !important; font-size: 14px;
    letter-spacing: .04em !important; text-transform: uppercase; color: var(--dd-ink);
  }
  .dd-gifts__title span { color: var(--dd-pink); }
  .dd-gifts__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; padding-top: 12px; }
  .dd-gift { position: relative; display: flex; flex-direction: column; align-items: center; min-width: 0; }
  .dd-gift__box {
    position: relative; width: 100%; aspect-ratio: 1 / 1; display: grid; place-items: center;
    background: var(--dd-sky); border: 2px solid #5b6cc4; border-radius: 16px;
  }
  .dd-gift__box img { width: 90%; height: 90%; object-fit: contain; }
  .dd-gift__ship { width: 82%; height: 82%; }
  .dd-gift__emoji { font-size: 64px; line-height: 1; }
  .dd-gift__pill {
    position: absolute; top: -11px; left: 50%; transform: translateX(-50%); z-index: 1; white-space: nowrap;
    padding: 3px 12px; border-radius: 999px; background: var(--dd-navy); color: #fff;
    font-family: var(--dd-font-heading) !important; font-weight: 800 !important; font-size: 11.5px; letter-spacing: .04em !important;
  }
  .dd-gift__pill s { opacity: .75; margin-left: 3px; font-weight: 700; }
  .dd-gift__label { margin-top: 8px; font-family: var(--dd-font-heading) !important; font-weight: 700 !important; font-size: 13.5px; line-height: 1.25; color: var(--dd-ink); }
  @media (max-width: 749px) {
    .dd-gifts__title { font-size: 11.5px; letter-spacing: .02em !important; }
    .dd-gifts__grid { gap: 10px; }
    .dd-gift__box { border-radius: 14px; }
    .dd-gift__emoji { font-size: 50px; }
    .dd-gift__pill { font-size: 10px; padding: 3px 9px; top: -10px; }
    .dd-gift__label { font-size: 12px; }
  }
</style>

<div class="dd-gifts" data-dd-gifts{% if s.gifts_auto_add %} data-gift-ids="{%- for h in gift_handles -%}{{ all_products[h].selected_or_first_available_variant.id }}{% unless forloop.last %},{% endunless %}{%- endfor -%}"{% endif %}>
  <p class="dd-gifts__title">{% if s.gifts_heading != blank %}<span>{{ s.gifts_heading }}</span> {% endif %}{{ s.gifts_heading_after }}</p>
  <div class="dd-gifts__grid">
    <div class="dd-gift">
      <div class="dd-gift__box">
        <span class="dd-gift__pill">FREE{% if s.gifts_shipping_value != blank %} <s>{{ s.gifts_shipping_value }}</s>{% endif %}</span>
        {%- if s.gifts_shipping_image != blank -%}
          {{ s.gifts_shipping_image | image_url: width: 300 | image_tag: loading: 'lazy', alt: s.gifts_shipping_label }}
        {%- else -%}
          <svg class="dd-gift__ship" viewBox="0 0 120 120" aria-hidden="true">
            <path d="M60 18 104 36v52L60 106 16 88V36z" fill="#c98d4f"/>
            <path d="M60 54v52L16 88V36z" fill="#d9a066"/>
            <path d="M60 54v52l44-18V36z" fill="#b97a3d"/>
            <path d="M16 36 60 18l44 18-44 18z" fill="#e4b47c"/>
            <path d="M38 27 82 45v14l-10 4V49L28 31z" fill="#f1d3a3"/>
            <path d="M60 54 16 36l-8 12 44 18z" fill="#e8bb84"/>
            <path d="M60 54l44-18 8 12-44 18z" fill="#d39a5c"/>
            <path d="M88 64c8 3 14 3 20 1v15c0 11-8 19-20 24-12-5-20-13-20-24V65c6 2 12 2 20-1z" fill="#2b3a8f" stroke="#fff" stroke-width="3"/>
            <path d="m79 83 6 6 12-13" fill="none" stroke="#fff" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        {%- endif -%}
      </div>
      <span class="dd-gift__label">{{ s.gifts_shipping_label }}</span>
    </div>

    {%- for h in gift_handles -%}
      {%- assign g = all_products[h] -%}
      {%- assign v = g.selected_or_first_available_variant -%}
      {%- if forloop.index == 1 -%}
        {%- assign label = s.gift_1_label | default: g.title -%}{%- assign value = s.gift_1_value -%}{%- assign emoji = '🎧' -%}
      {%- else -%}
        {%- assign label = s.gift_2_label | default: g.title -%}{%- assign value = s.gift_2_value -%}{%- assign emoji = '🧸' -%}
      {%- endif -%}
      {%- if value == blank and v.compare_at_price > 0 -%}{%- assign value = v.compare_at_price | money_without_trailing_zeros -%}{%- endif -%}
      <div class="dd-gift">
        <div class="dd-gift__box">
          <span class="dd-gift__pill">FREE{% if value != blank %} <s>{{ value }}</s>{% endif %}</span>
          {%- if g.featured_image -%}
            {{ g.featured_image | image_url: width: 300 | image_tag: loading: 'lazy', alt: label }}
          {%- else -%}
            <span class="dd-gift__emoji" aria-hidden="true">{{ emoji }}</span>
          {%- endif -%}
        </div>
        <span class="dd-gift__label">{{ label }}</span>
      </div>
    {%- endfor -%}
  </div>
</div>
