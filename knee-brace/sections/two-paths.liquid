{%- comment -%} Serif display face for the headings and prices, as on the reference layout. {%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&display=swap">
{%- liquid
  assign rp = section.settings.right_price
  if rp == blank and product
    assign rp = product.price | money
  endif
-%}
<section class="z2p"><div class="page-width">
<p class="z2p__eye">{{ section.settings.eyebrow | escape | replace: '[', '<span class="hl">' | replace: ']', '</span>' }}</p><h2 class="z2p__h">{{ section.settings.heading | escape | replace: '[', '<span class="hl">' | replace: ']', '</span>' }}<em>{{ section.settings.heading_2 | escape | replace: '[', '<span class="hl">' | replace: ']', '</span>' }}</em></h2><p class="z2p__sub">{{ section.settings.text | escape | replace: '[', '<span class="hl">' | replace: ']', '</span>' }}</p>
<div class="z2p__cards">
  <div class="z2p__card"><div class="z2p__head"><h3>{{ section.settings.left_title | escape | replace: '[', '<span class="hl">' | replace: ']', '</span>' }}</h3><strong>{{ section.settings.left_price | escape }}</strong><small>{{ section.settings.left_note | escape | replace: '[', '<span class="hl">' | replace: ']', '</span>' }}</small></div><ul role="list">{%- assign rows = section.settings.left_points | newline_to_br | split: '<br />' -%}{%- for r in rows -%}{%- if r != blank -%}<li>– {{ r | strip | escape }}</li>{%- endif -%}{%- endfor -%}</ul></div>
  <div class="z2p__card z2p__card--us"><div class="z2p__head"><h3>{{ section.settings.right_title | escape | replace: '[', '<span class="hl">' | replace: ']', '</span>' }}</h3><strong>{{ rp | escape }}</strong><small>{{ section.settings.right_note | escape | replace: '[', '<span class="hl">' | replace: ']', '</span>' }}</small></div><ul role="list">{%- assign rows = section.settings.right_points | newline_to_br | split: '<br />' -%}{%- for r in rows -%}{%- if r != blank -%}<li>✓ {{ r | strip | escape }}</li>{%- endif -%}{%- endfor -%}</ul></div>
</div>
<div class="z2p__cta"><a class="zbtn" href="#MainProduct">{{ section.settings.button | escape }}{% if section.settings.button_price and product %} — {{ product.price | money }}{% endif %}</a></div>
<p class="z2p__disc">{{ section.settings.disclaimer | escape | replace: '[', '<span class="hl">' | replace: ']', '</span>' }}</p></div></section>
{% schema %}
{"name":"Two paths comparison","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"A SIDE-BY-SIDE LOOK"},{"type":"text","id":"heading","label":"Heading line 1","default":"Two paths to a"},{"type":"text","id":"heading_2","label":"Heading line 2","default":"happier, steadier dog."},{"type":"textarea","id":"text","label":"Text","default":"Text"},
{"type":"text","id":"left_title","label":"Left title","default":"Surgery"},{"type":"text","id":"left_price","label":"Left price","default":"$0"},{"type":"text","id":"left_note","label":"Left note","default":"note"},{"type":"textarea","id":"left_points","label":"Left points","default":"Point"},
{"type":"text","id":"right_title","label":"Right title","default":"Our brace"},{"type":"text","id":"right_price","label":"Right price","info":"Leave empty to show the product's live price."},{"type":"text","id":"right_note","label":"Right note","default":"note"},{"type":"textarea","id":"right_points","label":"Right points","default":"Point"},
{"type":"text","id":"button","label":"Button","default":"Try It Risk-Free"},{"type":"checkbox","id":"button_price","label":"Show the live price on the button","default":true},{"type":"textarea","id":"disclaimer","label":"Disclaimer","default":"Disclaimer"}],"presets":[{"name":"Two paths comparison"}]}
{% endschema %}
