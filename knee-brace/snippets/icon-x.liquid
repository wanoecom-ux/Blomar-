{%- comment -%} Extra outline icons for the product page; anything else falls through to the icon snippet. {%- endcomment -%}
{%- case name -%}
{%- when 'help-circle' -%}<svg viewBox="0 0 24 24" width="{{ size | default: 20 }}" height="{{ size | default: 20 }}" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><path d="M9.4 9.2a2.7 2.7 0 0 1 5.2 1c0 1.8-2.6 2.4-2.6 4"/><path d="M12 17.4h.01"/></svg>
{%- when 'star-outline' -%}<svg viewBox="0 0 24 24" width="{{ size | default: 20 }}" height="{{ size | default: 20 }}" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><path d="m12 2.8 2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17.2l-5.7 3.1 1.2-6.4-4.7-4.4 6.4-.8L12 2.8Z"/></svg>
{%- when 'shield-check' -%}<svg viewBox="0 0 24 24" width="{{ size | default: 22 }}" height="{{ size | default: 22 }}" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2.5 4.5 5.5v6c0 4.6 3.2 8.4 7.5 10 4.3-1.6 7.5-5.4 7.5-10v-6L12 2.5Z"/><path d="m8.7 12.2 2.3 2.3 4.4-4.6"/></svg>
{%- when 'play' -%}<svg viewBox="0 0 24 24" width="{{ size | default: 14 }}" height="{{ size | default: 14 }}" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5L8 5.5Z"/></svg>
{%- else -%}{% render 'icon', name: name, size: size %}
{%- endcase -%}
