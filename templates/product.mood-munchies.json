        "custom_liquid_RphxqL": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"om-ship\">\n  <div class=\"om-ship__item\">\n    <span class=\"om-ship__dot\"></span>\n    <span class=\"om-ship__text\">Ships By Tomorrow</span>\n  </div>\n  <div class=\"om-ship__item\">\n    <svg class=\"om-ship__icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1B2A5E\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\n      <circle cx=\"12\" cy=\"12\" r=\"10\"/>\n      <path d=\"M2 12h20\"/>\n      <path d=\"M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z\"/>\n    </svg>\n    <span class=\"om-ship__text\">Free Shipping Worldwide</span>\n  </div>\n</div>\n\n<style>\n  .om-ship {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 10px;\n    background: #F5F5F5;\n    border-radius: 12px;\n    padding: 12px 14px;\n    margin: 12px 0;\n    box-sizing: border-box;\n    width: 100%;\n  }\n  .om-ship__item {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    flex: 1 1 50%;\n    min-width: 0;\n  }\n  .om-ship__text {\n    font-size: 13px;\n    font-weight: 700;\n    line-height: 1.25;\n    color: #111111;\n  }\n  .om-ship__dot {\n    width: 10px;\n    height: 10px;\n    border-radius: 50%;\n    background: #2E7D32;\n    flex-shrink: 0;\n    animation: om-pulse 1.8s infinite;\n  }\n  .om-ship__icon {\n    width: 18px;\n    height: 18px;\n    flex-shrink: 0;\n  }\n  @keyframes om-pulse {\n    0%   { box-shadow: 0 0 0 0 rgba(46,125,50,0.5); }\n    70%  { box-shadow: 0 0 0 7px rgba(46,125,50,0); }\n    100% { box-shadow: 0 0 0 0 rgba(46,125,50,0); }\n  }\n  @media (max-width: 360px) {\n    .om-ship__text { font-size: 12px; }\n    .om-ship { padding: 10px 12px; }\n  }\n</style>"
          }
        },
        "custom_liquid_Q4Brd6": {
          "type": "custom_liquid",
          "disabled": true,
          "settings": {
            "custom_liquid": "{%- liquid\n  assign ship_left = 'Shipped today'\n  assign ship_right = 'Free Shipping Worldwide'\n  assign c_green = '#4F9A3A'\n-%}\n\n<div class=\"sb-ship-bar\">\n  <div class=\"sb-ship-left\">\n    <span class=\"sb-dot\"></span>\n    <span>{{ ship_left }}</span>\n  </div>\n  <div class=\"sb-ship-right\">\n    <span class=\"sb-plane\" aria-hidden=\"true\">✈️</span>\n    <span>{{ ship_right }}</span>\n  </div>\n</div>\n\n<style>\n  .sb-ship-bar {\n    display: flex !important;\n    width: 100% !important;\n    box-sizing: border-box;\n    justify-content: center !important;\n    align-items: center !important;\n    flex-wrap: wrap;\n    gap: 8px 24px;\n    padding: 8px 0 !important;\n    margin: 0 auto !important;\n    font-size: 16px;\n    line-height: 1.3;\n    text-align: center;\n  }\n  .sb-ship-bar .sb-ship-left {\n    display: flex; align-items: center; justify-content: center; gap: 10px;\n    color: {{ c_green }};\n  }\n  .sb-ship-bar .sb-dot {\n    width: 12px; height: 12px; border-radius: 50%;\n    background: {{ c_green }};\n    flex-shrink: 0;\n    animation: sb-pulse 2s infinite;\n  }\n  @keyframes sb-pulse {\n    0%   { box-shadow: 0 0 0 0 rgba(79,154,58,.5); }\n    70%  { box-shadow: 0 0 0 8px rgba(79,154,58,0); }\n    100% { box-shadow: 0 0 0 0 rgba(79,154,58,0); }\n  }\n  .sb-ship-bar .sb-ship-right {\n    display: flex; align-items: center; justify-content: center; gap: 8px;\n    color: #111;\n  }\n  .sb-ship-bar .sb-plane { font-size: 18px; line-height: 1; }\n\n  @media (max-width: 749px) {\n    .sb-ship-bar { font-size: 14px; gap: 6px 16px; }\n    .sb-ship-bar .sb-plane { font-size: 16px; }\n  }\n</style>"
          }
        },
