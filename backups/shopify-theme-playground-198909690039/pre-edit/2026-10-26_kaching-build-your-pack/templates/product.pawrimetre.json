        "review_KxUDxe": {
          "type": "review",
          "settings": {
            "photo": "shopify://shop_images/037_ChatGPT_Image_Aug_7_2026_07_55_29_PM_f3d41783-b57b-4f9a-836f-3998b6548726.png",
            "rating": 5,
            "title": "Finally trust him off leash in the open",
            "text": "We adopted Cooper knowing he was a flight risk and our trainer wanted $2,800 for a full recall program with no guarantee it would even stick. We tried this collar instead. Set the boundary at the park we go to every morning, and within about a week he understood exactly where the edge was. Now he runs full speed and circles right back to us. The beep does all the work, we almost never go past that. Watching him actually be a dog without me holding my breath is everything.",
            "name": "— Marcus and Devon Riley, Bloomington IN",
            "verified": "Verified Buyer, purchased August 12th 2025"
          }
        },
        "t4": {
          "type": "review",
          "settings": {
            "photo": "shopify://shop_images/040_ChatGPT_Image_Aug_7_2026_10_22_18_PM_7210d458-1dd0-453d-90bb-8aa0ad03b364.png",
            "rating": 5,
            "title": "My door dasher finally stopped bolting",
            "text": "Bailey is a beagle so a nose with legs. The second the front door cracked open she was gone, straight for the street, and I lived in fear of it. Getting my yard properly fenced was going to run me around $4,500 and I rent, so that was never happening. This collar fixed the exact problem I thought was unfixable. She learned where the line is and now she waits by the door instead of blowing past me. I actually sleep at night. Set it up on the remote in one afternoon.",
            "name": "Terrence White, Springfield MO",
            "verified": "Verified Buyer, purchased March 5th 2026"
          }
        },
        "t2": {
          "type": "review",
          "settings": {
