{%- liquid
  if section.settings.product != blank
    assign shop_url = section.settings.product.url
  else
    assign shop_url = section.settings.cta_link | default: routes.all_products_collection_url
  endif
-%}
<article class="lst sec-scope" style="--lst-bg: {{ section.settings.bg }}; --lst-strip: {{ section.settings.strip_bg }}; --lst-strip-text: {{ section.settings.strip_text }}; --lst-badge: {{ section.settings.badge_bg }}; {% render 'section-vars', s: section.settings %}">
  <header class="lst__head">
    {%- if section.settings.image_1 or section.settings.image_2 -%}
      <div class="lst__photos{% if section.settings.image_1 == blank or section.settings.image_2 == blank %} lst__photos--one{% endif %}">
        {%- for n in (1..2) -%}
          {%- assign k = 'image_' | append: n -%}
          {%- if section.settings[k] -%}<div class="lst__photo">{{ section.settings[k] | image_url: width: 1000 | image_tag: widths: '400,600,800,1000', sizes: '(min-width: 800px) 380px, 50vw', fetchpriority: 'high', alt: '' }}</div>{%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
    <div class="lst__intro-wrap">
      {%- if section.settings.show_rating -%}<div class="rating-line center">{% render 'rating-badge', style: section.settings.rating_style, p: section.settings.product, label: section.settings.rating_label, count_text: section.settings.rating_count_text, color: section.settings.rating_color %}</div>{%- endif -%}
      <h1 class="h2 lst__title">{{ section.settings.heading | replace: '[', '<span class="hl">' | replace: ']', '</span>' }}</h1>
      {%- if section.settings.intro != blank -%}<div class="lst__intro rte">{{ section.settings.intro | replace: '[', '<span class="hl">' | replace: ']', '</span>' }}</div>{%- endif -%}
    </div>
    <ul class="lst__badges" role="list">
      {%- for n in (1..3) -%}
        {%- assign t = 'badge_' | append: n -%}
        {%- assign im = 'badge_' | append: n | append: '_image' -%}
        {%- assign ic = 'badge_' | append: n | append: '_icon' -%}
        {%- if section.settings[t] != blank -%}
          <li><span class="lst__badge-icon">{% render 'icon-slot', image: section.settings[im], name: section.settings[ic], size: 30 %}</span><span>{{ section.settings[t] }}</span></li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </header>

  <ol class="lst__list" role="list">
    {%- for block in section.blocks -%}
      {%- if block.type != 'reason' -%}{%- continue -%}{%- endif -%}
      <li class="lst__card" {{ block.shopify_attributes }}>
        <div class="lst__media">
          {%- if block.settings.image -%}
            {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400,600,800,1000', sizes: '(min-width: 800px) 720px, 100vw', alt: block.settings.title }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}
          {%- endif -%}
        </div>
        {%- if block.settings.caption != blank -%}<p class="lst__strip">{{ block.settings.caption | replace: '[', '<span class="hl">' | replace: ']', '</span>' }}</p>{%- endif -%}
        <div class="lst__copy">
          <h2 class="h3 lst__card-title">{% if section.settings.numbers %}{{ forloop.index }}. {% endif %}{{ block.settings.title | replace: '[', '<span class="hl">' | replace: ']', '</span>' }}</h2>
          {%- if block.settings.subtitle != blank -%}<p class="lst__sub">{{ block.settings.subtitle | replace: '[', '<span class="hl">' | replace: ']', '</span>' }}</p>{%- endif -%}
          <div class="rte">{{ block.settings.text | replace: '[', '<span class="hl">' | replace: ']', '</span>' }}</div>
        </div>
      </li>
    {%- endfor -%}
  </ol>

  {%- if section.settings.cta != blank -%}
    <div class="lst__cta">
      <a class="btn btn--accent btn--block" href="{{ shop_url }}">{{ section.settings.cta }}</a>
      {%- if section.settings.cta_note != blank -%}<p class="cta-trust">{{ section.settings.cta_note | replace: '[', '<span class="hl">' | replace: ']', '</span>' }}</p>{%- endif -%}
    </div>
  {%- endif -%}

  {%- if section.settings.sticky -%}
    <div class="lst-sticky{% if section.settings.sticky_desktop %} lst-sticky--all{% endif %}" data-lst-sticky hidden>
      <a class="btn btn--accent lst-sticky__btn" href="{{ shop_url }}">{{ section.settings.sticky_text }}</a>
    </div>
    <script>
      (() => {
        const bar = document.querySelector('[data-lst-sticky]');
        if (!bar) return;
        const update = () => { bar.hidden = window.scrollY < 300; };
        window.addEventListener('scroll', update, { passive: true });
        update();
      })();
    </script>
  {%- endif -%}
</article>
<style>
.lst{background:var(--lst-bg);padding-bottom:48px}
.lst__head{max-width:760px;margin-inline:auto;padding:16px 16px 0}
.lst__photos{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:24px}
.lst__photos--one{grid-template-columns:1fr}
.lst__photo{border-radius:14px;overflow:hidden;aspect-ratio:4/5;background:var(--color-card)}
.lst__photos--one .lst__photo{aspect-ratio:16/10}
.lst__photo img{width:100%;height:100%;object-fit:cover}
.lst__intro-wrap{text-align:center}
.lst__title{margin-bottom:.5em}
.lst__intro{font-size:1.02rem;max-width:620px;margin-inline:auto}
.lst__badges{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;list-style:none;margin:28px 0 8px;text-align:center}
.lst__badges li{display:flex;flex-direction:column;align-items:center;gap:10px;font-weight:var(--font-body-weight-bold);font-size:.85rem;line-height:1.25}
.lst__badge-icon{display:inline-flex;align-items:center;justify-content:center;width:64px;height:64px;border-radius:50%;background:var(--lst-badge,var(--color-accent));color:var(--color-accent-ink);border:1.5px solid var(--color-ink)}
.lst__badge-icon .icon--img{width:34px;height:34px}
.lst__list{max-width:760px;margin-inline:auto;list-style:none;display:flex;flex-direction:column;gap:32px;padding:32px 16px 8px}
.lst__card{background:var(--color-bg);border:1.5px solid var(--color-ink);border-radius:20px;overflow:hidden;box-shadow:5px 6px 0 var(--sec-shadow,var(--color-ink))}
.lst__media{aspect-ratio:4/3;background:var(--color-card)}
.lst__media img,.lst__media svg{width:100%;height:100%;object-fit:cover}
.lst__strip{margin:0;padding:12px 18px;background:var(--lst-strip,var(--color-accent));color:var(--lst-strip-text,#fff);font-weight:var(--font-body-weight-bold);text-align:center;font-size:.95rem;border-block:1.5px solid var(--color-ink)}
.lst__copy{padding:22px 20px 24px}
.lst__card-title{margin-bottom:.35em}
.lst__sub{font-weight:var(--font-body-weight-bold);margin-bottom:.6em}
.lst__cta{max-width:560px;margin:32px auto 0;padding-inline:16px;text-align:center}
.lst__cta .cta-trust{margin-top:12px;font-size:.85rem}
.lst-sticky{position:fixed;left:0;right:0;bottom:0;z-index:45;padding:10px 16px calc(10px + env(safe-area-inset-bottom));background:var(--color-bg);box-shadow:0 -6px 20px rgba(0,0,0,.12)}
.lst-sticky__btn{width:100%;min-height:52px;font-size:1.05rem;text-transform:uppercase;letter-spacing:.04em;border-radius:2px}
@media (min-width:990px){
  .lst-sticky:not(.lst-sticky--all){display:none!important}
  .lst-sticky--all{left:auto;right:24px;bottom:24px;padding:0;background:none;box-shadow:none}
  .lst-sticky--all .lst-sticky__btn{width:auto;padding:0 40px;box-shadow:5px 5px 0 var(--sec-shadow,var(--color-ink))}
  .lst__media{aspect-ratio:16/9}
}
@media (max-width:749px){.lst__title{font-size:calc(1.85rem * var(--heading-scale))}.template-page .lst ~ * .footer,.lst{scroll-margin-bottom:80px}}
</style>
{% schema %}
{"name":"Listicle","settings":[{"type":"header","content":"Top"},{"type":"image_picker","id":"image_1","label":"Top photo 1"},{"type":"image_picker","id":"image_2","label":"Top photo 2","info":"Two photos sit side by side. Use just one for a wide photo."},{"type":"checkbox","id":"show_rating","label":"Show star rating","default":true,"info":"Rating & review count come from the product below (via your review app)."},{"type":"select","id":"rating_style","label":"Star style","default":"stars","options":[{"value":"stars","label":"Plain stars, e.g. ★★★★★ (4.8) 1,234 Reviews"},{"value":"boxes","label":"Stars in coloured boxes"}]},{"type":"text","id":"rating_label","label":"Rating text","info":"Leave empty to show the product's real rating, e.g. (4.8)."},{"type":"text","id":"rating_count_text","label":"Or type your own count text","info":"e.g. 1,234 Reviews. Leave empty to use the real count. Only use numbers you can back up."},{"type":"color","id":"rating_color","label":"Star colour","default":"#FF9900"},{"type":"text","id":"heading","label":"Heading","default":"5 reasons dog owners are swapping fences for a GPS collar","info":"Put [square brackets] around words to highlight them."},{"type":"richtext","id":"intro","label":"Intro"},{"type":"header","content":"Round badges"},{"type":"text","id":"badge_1","label":"Badge 1 text","default":"Free shipping"},{"type":"select","id":"badge_1_icon","label":"Badge 1 built-in icon","default":"truck","options":[{"value":"star","label":"Star"},{"value":"truck","label":"Truck"},{"value":"shield","label":"Shield"},{"value":"check","label":"Tick"},{"value":"paw","label":"Paw"},{"value":"gps","label":"GPS pin"},{"value":"clock","label":"Clock"}]},{"type":"image_picker","id":"badge_1_image","label":"Badge 1 own icon (replaces built-in)"},{"type":"text","id":"badge_2","label":"Badge 2 text","default":"90-day money-back guarantee"},{"type":"select","id":"badge_2_icon","label":"Badge 2 built-in icon","default":"shield","options":[{"value":"star","label":"Star"},{"value":"truck","label":"Truck"},{"value":"shield","label":"Shield"},{"value":"check","label":"Tick"},{"value":"paw","label":"Paw"},{"value":"gps","label":"GPS pin"},{"value":"clock","label":"Clock"}]},{"type":"image_picker","id":"badge_2_image","label":"Badge 2 own icon (replaces built-in)"},{"type":"text","id":"badge_3","label":"Badge 3 text","default":"No monthly fees"},{"type":"select","id":"badge_3_icon","label":"Badge 3 built-in icon","default":"check","options":[{"value":"star","label":"Star"},{"value":"truck","label":"Truck"},{"value":"shield","label":"Shield"},{"value":"check","label":"Tick"},{"value":"paw","label":"Paw"},{"value":"gps","label":"GPS pin"},{"value":"clock","label":"Clock"}]},{"type":"image_picker","id":"badge_3_image","label":"Badge 3 own icon (replaces built-in)"},{"type":"header","content":"Reasons"},{"type":"checkbox","id":"numbers","label":"Number the headings (1., 2., 3.)","default":true},{"type":"header","content":"Button"},{"type":"product","id":"product","label":"Product the buttons link to"},{"type":"url","id":"cta_link","label":"Or link to"},{"type":"text","id":"cta","label":"Button under the reasons","default":"Shop now"},{"type":"text","id":"cta_note","label":"Line under the button","default":"Free shipping · 90-day money-back guarantee"},{"type":"checkbox","id":"sticky","label":"Sticky shop button at the bottom of the screen","default":true},{"type":"checkbox","id":"sticky_desktop","label":"Also show the sticky button on desktop","default":false},{"type":"text","id":"sticky_text","label":"Sticky button text","default":"Shop now"},{"type":"header","content":"Colours"},{"type":"paragraph","content":"Leave any colour empty to use the theme colours."},{"type":"color","id":"bg","label":"Page background","default":"#F7EFDE"},{"type":"color","id":"badge_bg","label":"Badge circle"},{"type":"color","id":"strip_bg","label":"Caption strip background"},{"type":"color","id":"strip_text","label":"Caption strip text","default":"#FFFFFF"},{"type":"color","id":"c_text","label":"Text"},{"type":"color","id":"c_heading","label":"Headings"},{"type":"color","id":"c_accent","label":"Accent (buttons, badges, strips)"},{"type":"color","id":"c_btn_text","label":"Button text"},{"type":"color","id":"c_shadow","label":"Card & button shadow"}],"blocks":[{"type":"reason","name":"Reason","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"caption","label":"Caption strip under the image","default":"Short punchy line"},{"type":"text","id":"title","label":"Heading","default":"Reason heading","info":"Put [square brackets] around words to highlight them."},{"type":"text","id":"subtitle","label":"Bold line under heading"},{"type":"richtext","id":"text","label":"Text","default":"<p>Explain the reason in a few sentences.</p>"}]}],"presets":[{"name":"Listicle","blocks":[{"type":"reason"},{"type":"reason"},{"type":"reason"}]}]}
