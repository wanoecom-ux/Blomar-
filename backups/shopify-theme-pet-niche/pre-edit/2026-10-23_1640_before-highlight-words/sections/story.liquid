<section class="section story sec-scope{% if section.settings.mobile_center %} story--m-center{% endif %}" id="{{ section.settings.anchor | handleize }}" style="{% render 'section-vars', s: section.settings %}">
  <div class="page-width story__grid{% if section.settings.image_right %} story__grid--flip{% endif %}">
    <div class="story__head">
      {%- if section.settings.eyebrow != blank -%}{%- if section.settings.label_style == 'boxed' -%}<p class="label-box" style="--lb-bg: {{ section.settings.label_bg }}; --lb-color: {{ section.settings.label_color }};">{{ section.settings.eyebrow }}</p>{%- else -%}<p class="eyebrow eyebrow--accent">{{ section.settings.eyebrow }}</p>{%- endif -%}{%- endif -%}
      <h2 class="h2{% if section.settings.heading_style == 'caps' %} h-caps{% endif %}">{{ section.settings.heading }}</h2>
    </div>
    <div class="story__media{% if section.settings.media_shadow %} offset-card{% endif %}">
      {%- if section.settings.image -%}
        {{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '500,750,1000', sizes: '(min-width: 990px) 45vw, 100vw', alt: section.settings.heading }}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder' }}
      {%- endif -%}
    </div>
    <div class="rte story__text">{{ section.settings.text }}</div>
  </div>
</section>
<style>
.story__grid{display:grid;gap:20px;grid-template-areas:"head" "media" "text"}
.story__head{grid-area:head}.story__media{grid-area:media}.story__text{grid-area:text}
.story__head .h2{margin:0}
@media (max-width:989px){.story--m-center .story__head,.story--m-center .story__text{text-align:center}}
@media (min-width:990px){
  .story__grid{grid-template-columns:1.1fr 1fr;column-gap:56px;row-gap:18px;grid-template-areas:"head media" "text media";align-items:start}
  .story__grid--flip{grid-template-columns:1.1fr 1fr;grid-template-areas:"head media" "text media"}
  .story__grid:not(.story__grid--flip){grid-template-columns:1fr 1.1fr;grid-template-areas:"media head" "media text"}
  .story__head{align-self:end}
  .story__media{align-self:center}
}
.story__media{border-radius:var(--radius);overflow:hidden;aspect-ratio:4/5;background:var(--color-card)}
.story__media img,.story__media svg{width:100%;height:100%;object-fit:cover}
.story__text p{font-size:1.1rem;line-height:1.6}
.story__text strong{font-weight:var(--font-body-weight-bold);color:var(--color-ink)}
</style>
{% schema %}
{"name":"Story (image + text)","settings":[{"type":"text","id":"anchor","label":"Anchor ID","default":"problem"},{"type":"image_picker","id":"image","label":"Image"},{"type":"checkbox","id":"image_right","label":"Image on the right","default":false},{"type":"text","id":"eyebrow","label":"Small label","default":"The problem"},{"type":"header","content":"Label & heading style"},{"type":"select","id":"label_style","label":"Small label style","default":"plain","options":[{"value":"plain","label":"Plain text"},{"value":"boxed","label":"Boxed (dashed border)"}]},{"type":"color","id":"label_bg","label":"Boxed label background","default":"#FBF4E8"},{"type":"color","id":"label_color","label":"Label text colour","default":"#101A2B"},{"type":"select","id":"heading_style","label":"Heading style","default":"theme","options":[{"value":"theme","label":"Theme heading font"},{"value":"caps","label":"Bold capitals (body font)"}]},{"type":"text","id":"heading","label":"Heading","default":"Heading"},{"type":"richtext","id":"text","label":"Text","default":"<p>Tell the story.</p>"},{"type":"checkbox","id":"mobile_center","label":"Mobile: centre the heading and text","default":true},{"type":"checkbox","id":"media_shadow","label":"Photo with border & offset shadow","default":false},{"type":"header","content":"Colours"},{"type":"paragraph","content":"Leave any colour empty to use the theme colours."},{"type":"color","id":"c_bg","label":"Background"},{"type":"color","id":"c_text","label":"Text"},{"type":"color","id":"c_heading","label":"Headings"},{"type":"color","id":"c_accent","label":"Accent (buttons, ticks, icons, highlights)"},{"type":"color","id":"c_btn_text","label":"Button text"},{"type":"color","id":"c_shadow","label":"Card & button shadow"}],"presets":[{"name":"Story (image + text)"}]}
{% endschema %}