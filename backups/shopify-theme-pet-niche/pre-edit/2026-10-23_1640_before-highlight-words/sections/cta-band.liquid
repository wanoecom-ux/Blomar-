<section class="section cta-band" style="--cta-bg: {{ section.settings.bg }};">
  <div class="page-width center cta-band__inner">
    {%- if section.settings.heading != blank -%}<h2 class="h2">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<p class="muted narrow">{{ section.settings.text }}</p>{%- endif -%}
    <a class="btn btn--accent btn--lg" href="{% if section.settings.product != blank %}{{ section.settings.product.url }}{% elsif section.settings.link != blank %}{{ section.settings.link }}{% else %}{{ routes.all_products_collection_url }}{% endif %}">{{ section.settings.button }}</a>
    {%- if section.settings.note != blank -%}<p class="small muted cta-band__note">{% render 'icon-slot', image: section.settings.note_icon, name: 'shield', size: 16 %} {{ section.settings.note }}</p>{%- endif -%}
  </div>
</section>
<style>
.cta-band{background:var(--cta-bg)}
.cta-band__inner{display:flex;flex-direction:column;align-items:center;gap:12px}
.cta-band__note{display:inline-flex;align-items:center;gap:6px;margin:0}
</style>
{% schema %}
{"name":"Button band","settings":[{"type":"color","id":"bg","label":"Background","default":"#FFFFFF"},{"type":"text","id":"heading","label":"Heading","default":"Ready to get started?"},{"type":"text","id":"text","label":"Text"},{"type":"text","id":"button","label":"Button text","default":"Shop now"},{"type":"product","id":"product","label":"Product the button links to"},{"type":"url","id":"link","label":"Or button link"},{"type":"text","id":"note","label":"Text under button","default":"Secure checkout · 90-day money-back guarantee"},{"type":"image_picker","id":"note_icon","label":"Icon next to the text under the button","info":"Upload a PNG or SVG. Square works best."}],"presets":[{"name":"Button band"}]}
{% endschema %}