<section class="section" id="{{ section.settings.anchor | handleize }}" data-carousel>
  <div class="page-width">
    <div class="section-head section-head--row">
      <h2 class="h2">{{ section.settings.heading }}</h2>
      <div class="carousel-nav">
        <button type="button" class="round-btn" data-carousel-prev aria-label="Previous">{% render 'icon', name: 'arrow-left', size: 18 %}</button>
        <button type="button" class="round-btn round-btn--accent" data-carousel-next aria-label="Next">{% render 'icon', name: 'arrow', size: 18 %}</button>
      </div>
    </div>
    <div class="carousel" data-carousel-track>
      {%- for block in section.blocks -%}
        <div class="carousel__slide" {{ block.shopify_attributes }}>
          <article class="feature-card">
            <h3 class="h4">{{ block.settings.title }}</h3>
            <div class="feature-card__media">
              {%- if block.settings.image -%}
                {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: block.settings.title }}
              {%- else -%}
                <span class="feature-card__icon">{% render 'icon-slot', image: block.settings.custom_icon, name: block.settings.icon, size: 56 %}</span>
              {%- endif -%}
            </div>
            {%- if block.settings.text != blank -%}<p class="small muted">{{ block.settings.text }}</p>{%- endif -%}
          </article>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{"name":"Feature cards","settings":[{"type":"text","id":"anchor","label":"Anchor ID","default":"features"},{"type":"text","id":"heading","label":"Heading","default":"What's inside"}],"blocks":[{"type":"card","name":"Card","settings":[{"type":"text","id":"title","label":"Title","default":"Feature"},{"type":"image_picker","id":"image","label":"Image"},{"type":"select","id":"icon","label":"Icon (if no image)","default":"gps","options":[{"value":"gps","label":"GPS pin"},{"value":"remote","label":"Remote"},{"value":"dogs","label":"Dogs"},{"value":"drop","label":"Water drop"},{"value":"battery","label":"Battery"},{"value":"shield","label":"Shield"},{"value":"tool","label":"Tool"},{"value":"paw","label":"Paw"},{"value":"none","label":"None"}]},{"type":"image_picker","id":"custom_icon","label":"Your own icon (replaces the one above)","info":"Upload a PNG or SVG. Square works best."},{"type":"textarea","id":"text","label":"Text"}]}],"presets":[{"name":"Feature cards","blocks":[{"type":"card"},{"type":"card"},{"type":"card"}]}]}
{% endschema %}