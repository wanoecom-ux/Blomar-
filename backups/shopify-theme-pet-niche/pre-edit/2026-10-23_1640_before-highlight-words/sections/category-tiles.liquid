<section class="section">
  <div class="page-width">
    <div class="section-head section-head--row">
      <div>
        {%- if section.settings.heading != blank -%}<h2 class="h2">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<p class="muted">{{ section.settings.text }}</p>{%- endif -%}
      </div>
      {%- if section.settings.link_label != blank -%}<a class="text-link" href="{{ section.settings.link | default: routes.collections_url }}">{{ section.settings.link_label }} {% render 'icon', name: 'arrow', size: 16 %}</a>{%- endif -%}
    </div>
    <div class="tiles">
      {%- for block in section.blocks -%}
        <a class="tile" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
          {%- if block.settings.image -%}
            {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400,600,800', sizes: '(min-width: 990px) 25vw, 50vw', alt: block.settings.label }}
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder' }}
          {%- endif -%}
          <span class="tile__pill">{{ block.settings.label }} {% render 'icon', name: 'arrow', size: 16 %}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Category tiles",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Everything for the escape artist" },
    { "type": "text", "id": "text", "label": "Text", "default": "Shop by what your dog needs most." },
    { "type": "text", "id": "link_label", "label": "Link text", "default": "View all products" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "blocks": [
    { "type": "tile", "name": "Tile", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "label", "label": "Label", "default": "GPS fences" },
      { "type": "url", "id": "link", "label": "Link" }
    ] }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Category tiles", "blocks": [{ "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" }] }]
}
{% endschema %}