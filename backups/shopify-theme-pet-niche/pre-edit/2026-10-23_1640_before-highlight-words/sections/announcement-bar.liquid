{%- assign promos = section.blocks | where: 'type', 'countdown' -%}
{%- assign messages = section.blocks | where: 'type', 'message' -%}
{%- for block in promos -%}
  <div class="promo-bar" style="--pb-bg: {{ block.settings.bg }}; --pb-fg: {{ block.settings.fg }}; --pb-timer: {{ block.settings.timer_color }};" data-countdown="{{ block.settings.end_at | escape }}" {{ block.shopify_attributes }}>
    <div class="page-width promo-bar__inner">
      <a class="promo-bar__text" href="{{ block.settings.link | default: '#' }}">
        <strong>{{ block.settings.title }}</strong>
        {%- if block.settings.subtitle != blank -%}<span>{{ block.settings.subtitle }}</span>{%- endif -%}
      </a>
      <div class="promo-bar__timer" data-timer hidden>
        <span><b data-h>00</b><small>{{ block.settings.label_h }}</small></span><i>:</i>
        <span><b data-m>00</b><small>{{ block.settings.label_m }}</small></span><i>:</i>
        <span><b data-s>00</b><small>{{ block.settings.label_s }}</small></span>
      </div>
    </div>
  </div>
{%- endfor -%}
{%- if messages.size > 0 -%}
<div class="announce" style="--announce-bg: {{ section.settings.bg }}; --announce-fg: {{ section.settings.fg }};" data-rotator>
  <div class="page-width announce__inner">
    <button class="announce__nav" type="button" data-rotator-prev aria-label="Previous">{% render 'icon', name: 'arrow-left', size: 16 %}</button>
    <div class="announce__track">
      {%- for block in messages -%}
        <p class="announce__item{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.text }}</a>{%- else -%}{{ block.settings.text }}{%- endif -%}
        </p>
      {%- endfor -%}
    </div>
    <button class="announce__nav" type="button" data-rotator-next aria-label="Next">{% render 'icon', name: 'arrow', size: 16 %}</button>
  </div>
</div>
{%- endif -%}
<style>
.promo-bar{background:var(--pb-bg);color:var(--pb-fg)}
.promo-bar__inner{display:flex;align-items:center;justify-content:center;gap:16px;min-height:52px;padding-block:6px}
.promo-bar__text{display:flex;flex-direction:column;align-items:center;line-height:1.15;text-align:center}
.promo-bar__text strong{font-size:.95rem;text-transform:uppercase;font-weight:var(--font-body-weight-bold)}
.promo-bar__text span{font-size:.7rem;text-transform:uppercase;letter-spacing:.03em}
.promo-bar__timer{display:flex;align-items:flex-start;gap:6px;font-variant-numeric:tabular-nums}
.promo-bar__timer span{display:flex;flex-direction:column;align-items:center;line-height:1}
.promo-bar__timer b{font-size:1.35rem;color:var(--pb-timer);font-weight:var(--font-body-weight-bold)}
.promo-bar__timer small{font-size:.62rem;margin-top:2px}
.promo-bar__timer i{font-style:normal;color:var(--pb-timer);font-weight:700;font-size:1.2rem}
</style>
<script>
(() => {
  document.querySelectorAll('[data-countdown]').forEach((bar) => {
    const raw = (bar.getAttribute('data-countdown') || '').trim();
    if (!raw) return;
    const end = new Date(raw.replace(' ', 'T'));
    if (isNaN(end)) return;
    const timer = bar.querySelector('[data-timer]');
    const h = bar.querySelector('[data-h]'), m = bar.querySelector('[data-m]'), s = bar.querySelector('[data-s]');
    const pad = (n) => String(n).padStart(2, '0');
    const tick = () => {
      const left = Math.floor((end - Date.now()) / 1000);
      if (left <= 0) { timer.hidden = true; clearInterval(id); return; }
      timer.hidden = false;
      h.textContent = pad(Math.floor(left / 3600)); m.textContent = pad(Math.floor(left % 3600 / 60)); s.textContent = pad(left % 60);
    };
    const id = setInterval(tick, 1000); tick();
  });
})();
</script>
{% schema %}
{"name":"Announcement bar","settings":[{"type":"color","id":"bg","label":"Message bar background","default":"#101A2B"},{"type":"color","id":"fg","label":"Message bar text","default":"#FFFFFF"}],"blocks":[{"type":"countdown","name":"Sale bar with timer","limit":1,"settings":[{"type":"text","id":"title","label":"Headline","default":"Spring sale"},{"type":"text","id":"subtitle","label":"Small line","default":"Limited time"},{"type":"url","id":"link","label":"Link"},{"type":"text","id":"end_at","label":"Sale ends (date & time)","info":"Format: 2026-11-30 23:59 (shopper's local time). The timer only shows before this time and hides when the sale ends. Use your real end date."},{"type":"text","id":"label_h","label":"Hours label","default":"Hrs"},{"type":"text","id":"label_m","label":"Minutes label","default":"Mins"},{"type":"text","id":"label_s","label":"Seconds label","default":"Secs"},{"type":"color","id":"bg","label":"Background","default":"#101A2B"},{"type":"color","id":"fg","label":"Text","default":"#FFFFFF"},{"type":"color","id":"timer_color","label":"Timer numbers","default":"#DB6742"}]},{"type":"message","name":"Message","settings":[{"type":"text","id":"text","label":"Text","default":"Free shipping on every order"},{"type":"url","id":"link","label":"Link"}]}],"max_blocks":7}
{% endschema %}
