    "stories": {
      "type": "pf-testimonials",
      "blocks": {
        "t2": {
          "type": "review",
          "settings": {
            "photo": "shopify://shop_images/042_9e112151-9c31-481f-837c-f0956fdfbec3.png",
            "rating": 5,
            "title": "Finally trust him off leash in the open",
            "text": "We adopted Cooper knowing he was a flight risk and our trainer wanted $2,800 for a full recall program with no guarantee it would even stick. We tried this collar instead. Set the boundary at the park we go to every morning, and within about a week he understood exactly where the edge was. Now he runs full speed and circles right back to us. The beep does all the work, we almost never go past that. Watching him actually be a dog without me holding my breath is everything.",
            "name": "Marcus and Devon Riley, Bloomington IN",
            "verified": "Verified Buyer, purchased May 22nd 2025"
          }
        },
        "t1": {
          "type": "review",
          "settings": {
            "photo": "shopify://shop_images/041_ChatGPT_Image_Aug_7_2026_10_24_09_PM_ddd397a3-ed47-483e-9261-2b87b0f77cc5.png",
            "rating": 5,
            "title": "Contained a working breed with zero digging",
            "text": "Everyone warned me a border collie needs a real fence or he’d find a way out, and the quote to fence our whole yard was $6,000. No thanks. Rocky is smart and stubborn but he figured out the boundary in under a week. Best part, no trenching, no wires buried in my lawn, no contractor. I set the shape myself and it wraps around our weird angled yard perfectly. He plays like a maniac right up to the edge and never crosses. Battery easily lasts me four days.",
            "name": "Colleen Ferraro, Erie PA",
            "verified": "Verified Buyer, purchased August 12th 2025"
          }
        },
        "t3": {
          "type": "review",
          "settings": {
            "photo": "shopify://shop_images/038_ChatGPT_Image_Aug_7_2026_08_03_11_PM_a9f0addd-2315-4c86-841e-3130bafa9928.png",
            "rating": 5,
            "title": "No more getting dragged down the block",
            "text": "“Every walk with Sunny used to wreck my shoulder. She pulled the entire time and I dreaded taking her out. What sold me was that this is a fence AND a trainer in one. I use the remote on our walks now, a quick vibrate when she lunges and she settles right down. Three weeks in and she walks next to me like a completely different dog. I was quoted $1,500 for group obedience classes and this did more in a month. The remote is simple, my battery goes about four days.”",
            "name": "Janet Collins, Naperville IL",
            "verified": "Verified Buyer, purchased July 29th 2025"
          }
        },
        "t4": {
          "type": "review",
          "settings": {
            "photo": "shopify://shop_images/040_ChatGPT_Image_Aug_7_2026_10_22_18_PM_7210d458-1dd0-453d-90bb-8aa0ad03b364.png",
            "rating": 5,
            "title": "My door dasher finally stopped bolting",
            "text": "Bailey is a beagle so a nose with legs. The second the front door cracked open she was gone, straight for the street, and I lived in fear of it. Getting my yard properly fenced was going to run me around $4,500 and I rent, so that was never happening. This collar fixed the exact problem I thought was unfixable. She learned where the line is and now she waits by the door instead of blowing past me. I actually sleep at night. Set it up on the remote in one afternoon.",
            "name": "Terrence White, Springfield MO",
            "verified": "Verified Buyer, purchased March 5th 2026"
          }
        },
        "review_KxUDxe": {
          "type": "review",
          "settings": {
            "photo": "shopify://shop_images/037_ChatGPT_Image_Aug_7_2026_07_55_29_PM_f3d41783-b57b-4f9a-836f-3998b6548726.png",
            "rating": 5,
            "title": "Finally trust him off leash in the open",
            "text": "We adopted Cooper knowing he was a flight risk and our trainer wanted $2,800 for a full recall program with no guarantee it would even stick. We tried this collar instead. Set the boundary at the park we go to every morning, and within about a week he understood exactly where the edge was. Now he runs full speed and circles right back to us. The beep does all the work, we almost never go past that. Watching him actually be a dog without me holding my breath is everything.",
            "name": "— Marcus and Devon Riley, Bloomington IN",
            "verified": "Verified Buyer, purchased August 12th 2025"
          }
        },
        "review_WELEEG": {
          "type": "review",
          "settings": {
            "photo": "shopify://shop_images/039_ChatGPT_Image_Aug_7_2026_08_12_16_PM_4049a61e-2a0a-495b-82bc-2985c3f680e4.png",
            "rating": 5,
            "title": "Wish I’d started this when he was a puppy",
            "text": "“My biggest regret is not getting this the day we brought Ziggy home. We let the puppy stage slide and by a year old he thought the whole neighbourhood was his. Started fresh with this collar and even a little late he picked up the boundary in maybe eight days. If you have a young dog, do it now while their habits are still forming. Adjustable modes meant I started with just the beep on the lowest setting. Never had to go higher. He is 100 percent trustworthy in the yard now.”",
            "name": "Hannah Voss, Fort Collins CO",
            "verified": "Verified Buyer, purchased June 3rd 2025"
          }
        }
      },
