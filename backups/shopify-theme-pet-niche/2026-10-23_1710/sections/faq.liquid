<section class="section" id="{{ section.settings.anchor | handleize }}">
  <div class="page-width faq">
    <div class="section-head center">
      <h2 class="h2">{{ section.settings.heading | replace: '[', '<span class="hl">' | replace: ']', '</span>' }}</h2>
      {%- if section.settings.text != blank -%}<p class="muted">{{ section.settings.text | replace: '[', '<span class="hl">' | replace: ']', '</span>' }}</p>{%- endif -%}
    </div>
    <div class="accordion">
      {%- for block in section.blocks -%}
        <details class="accordion__item" {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question | replace: '[', '<span class="hl">' | replace: ']', '</span>' }} <span class="accordion__icon">{% render 'icon', name: 'chevron', size: 18 %}</span></summary>
          <div class="accordion__body rte">{{ block.settings.answer | replace: '[', '<span class="hl">' | replace: ']', '</span>' }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "faq" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions? We've got you.", "info": "Put [square brackets] around words to highlight them." },
    { "type": "text", "id": "text", "label": "Text", "default": "Can't see yours? Email us and a real person will reply." }
  ],
  "blocks": [
    { "type": "question", "name": "Question", "settings": [
      { "type": "text", "id": "question", "label": "Question", "default": "Question" },
      { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Answer</p>" }
    ] }
  ],
  "presets": [{ "name": "FAQ", "blocks": [{ "type": "question" }, { "type": "question" }] }]
}
{% endschema %}