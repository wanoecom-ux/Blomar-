<section class="section" id="{{ section.settings.anchor | handleize }}">
  <div class="page-width">
    <div class="section-head section-head--row"><h2 class="h2">{{ section.settings.heading | replace: '[', '<span class="hl">' | replace: ']', '</span>' }}</h2></div>
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}{% render block %}
        {%- endcase -%}
      {%- endfor -%}
    {%- else -%}
      <div class="reviews-empty"><p>{{ section.settings.empty_text | replace: '[', '<span class="hl">' | replace: ']', '</span>' }}</p></div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Reviews",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What dog parents are saying", "info": "Put [square brackets] around words to highlight them." },
    { "type": "text", "id": "empty_text", "label": "Text before reviews arrive", "default": "Reviews from verified buyers will show here." },
    { "type": "paragraph", "content": "Add your review app's widget as a block here (Judge.me, Loox, Okendo, etc.)." }
  ],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "Reviews" }]
}
{% endschema %}