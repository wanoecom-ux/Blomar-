<section class="trust-strip">
  <div class="page-width trust-strip__inner" role="list">
    {%- for block in section.blocks -%}
      <div class="trust-strip__item" role="listitem" {{ block.shopify_attributes }}>
        <span class="trust-strip__icon">{% render 'icon-slot', image: block.settings.custom_icon, name: block.settings.icon, size: 26 %}</span>
        <span><strong>{{ block.settings.title | replace: '[', '<span class="hl">' | replace: ']', '</span>' }}</strong>{% if block.settings.sub != blank %}<small>{{ block.settings.sub | replace: '[', '<span class="hl">' | replace: ']', '</span>' }}</small>{% endif %}</span>
      </div>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{"name":"Trust strip","blocks":[{"type":"item","name":"Item","settings":[{"type":"select","id":"icon","label":"Icon","default":"shield","options":[{"value":"shield","label":"Shield"},{"value":"truck","label":"Truck"},{"value":"gps","label":"GPS pin"},{"value":"remote","label":"Remote"},{"value":"drop","label":"Water drop"},{"value":"battery","label":"Battery"},{"value":"dogs","label":"Dogs"},{"value":"paw","label":"Paw"},{"value":"clock","label":"Clock"},{"value":"gift","label":"Gift"},{"value":"none","label":"None"}]},{"type":"image_picker","id":"custom_icon","label":"Your own icon (replaces the one above)","info":"Upload a PNG or SVG. Square works best."},{"type":"text","id":"title","label":"Title","default":"Free shipping","info":"Put [square brackets] around words to highlight them."},{"type":"text","id":"sub","label":"Small text","default":"On every order"}]}],"max_blocks":6,"presets":[{"name":"Trust strip","blocks":[{"type":"item"},{"type":"item"},{"type":"item"}]}]}
{% endschema %}