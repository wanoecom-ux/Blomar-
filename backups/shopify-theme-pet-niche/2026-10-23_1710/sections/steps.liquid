<section class="section section--tint" id="{{ section.settings.anchor | handleize }}">
  <div class="page-width">
    <div class="section-head center"><h2 class="h2">{{ section.settings.heading | replace: '[', '<span class="hl">' | replace: ']', '</span>' }}</h2></div>
    <ol class="steps" role="list">
      {%- for block in section.blocks -%}
        <li class="step" {{ block.shopify_attributes }}>
          <div class="step__media">
            {%- if block.settings.image -%}
              {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350,500,700', sizes: '(min-width: 990px) 30vw, 100vw', alt: block.settings.title }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}
            {%- endif -%}
            <span class="step__num">{{ forloop.index }}</span>
          </div>
          <h3 class="h4">{{ block.settings.title | replace: '[', '<span class="hl">' | replace: ']', '</span>' }}</h3>
          <p class="muted">{{ block.settings.text | replace: '[', '<span class="hl">' | replace: ']', '</span>' }}</p>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>
{% schema %}
{
  "name": "Steps",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "how-to-use" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Up and running in an afternoon", "info": "Put [square brackets] around words to highlight them." }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "title", "label": "Title", "default": "Step" },
      { "type": "textarea", "id": "text", "label": "Text" }
    ] }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Steps", "blocks": [{ "type": "step" }, { "type": "step" }, { "type": "step" }] }]
}
{% endschema %}