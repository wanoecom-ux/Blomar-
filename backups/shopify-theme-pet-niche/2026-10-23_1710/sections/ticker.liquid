{%- assign items = section.settings.items | split: ',' -%}
<div class="tk{% if section.settings.caps %} tk--caps{% endif %}" style="--tk-bg: {{ section.settings.bg }}; --tk-fg: {{ section.settings.fg }}; --tk-size: {{ section.settings.size | divided_by: 10.0 }}rem;" aria-hidden="true">
  <div class="tk__track">
    {%- for r in (1..3) -%}{%- for t in items -%}<span>{% if section.settings.show_icon %}{% render 'icon-slot', image: section.settings.icon_image, name: 'paw', size: 16 %} {% endif %}{{ t | strip }}</span>{%- endfor -%}{%- endfor -%}
  </div>
</div>
<style>
.tk{background:var(--tk-bg);color:var(--tk-fg);overflow:hidden;padding:12px 0;font-weight:var(--font-body-weight-bold);font-size:var(--tk-size,1.3rem)}
.tk--caps{text-transform:uppercase;letter-spacing:.04em}
.tk__track{display:flex;gap:56px;width:max-content;animation:tk-scroll 40s linear infinite}
.tk__track span{display:inline-flex;align-items:center;gap:8px;white-space:nowrap}
@keyframes tk-scroll{to{transform:translateX(-33.333%)}}
</style>
{% schema %}
{"name":"Scrolling ticker","settings":[{"type":"text","id":"items","label":"Items (comma separated)","default":"Trainer-friendly,Fence + trainer in one,No monthly fees,GPS boundary,Up to 3 dogs"},{"type":"color","id":"bg","label":"Background","default":"#1F3A68"},{"type":"color","id":"fg","label":"Text","default":"#FFFFFF"},{"type":"image_picker","id":"icon_image","label":"Your own icon between items (replaces the paw)","info":"Upload a PNG or SVG. Square works best."},{"type":"range","id":"size","label":"Text size","min":8,"max":24,"step":1,"default":13},{"type":"checkbox","id":"caps","label":"All capitals","default":false},{"type":"checkbox","id":"show_icon","label":"Show icon between items","default":true}],"presets":[{"name":"Scrolling ticker"}]}
{% endschema %}
