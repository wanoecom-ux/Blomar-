<section class="section" id="{{ section.settings.anchor | handleize }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-head center">
        <h2 class="h2">{{ section.settings.heading | replace: '[', '<span class="hl">' | replace: ']', '</span>' }}</h2>
        {%- if section.settings.text != blank -%}<p class="muted narrow">{{ section.settings.text | replace: '[', '<span class="hl">' | replace: ']', '</span>' }}</p>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="quote-split">
      <figure class="quote-card">
        <blockquote>{{ section.settings.quote | replace: '[', '<span class="hl">' | replace: ']', '</span>' }}</blockquote>
        <figcaption>
          <strong>{{ section.settings.name }} {% if section.settings.verified %}<span class="accent">{% render 'icon', name: 'verified', size: 16 %}</span>{% endif %}</strong>
          <span class="small muted">{{ section.settings.role }}</span>
        </figcaption>
      </figure>
      <div class="quote-split__media">
        {%- if section.settings.image -%}
          {{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '500,750,1000', sizes: '(min-width: 990px) 45vw, 100vw', alt: section.settings.name }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Expert quote",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "expert" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Trainer-approved approach", "info": "Put [square brackets] around words to highlight them." },
    { "type": "text", "id": "text", "label": "Text", "default": "Clear boundaries, gentle cues and lots of praise. That's how dogs learn fastest." },
    { "type": "textarea", "id": "quote", "label": "Quote", "default": "Replace this with a real quote from a trainer or vet you work with. Only use words they've approved." },
    { "type": "text", "id": "name", "label": "Name", "default": "Expert name" },
    { "type": "text", "id": "role", "label": "Role", "default": "Certified dog trainer" },
    { "type": "checkbox", "id": "verified", "label": "Show verified badge", "default": false },
    { "type": "image_picker", "id": "image", "label": "Photo" }
  ],
  "presets": [{ "name": "Expert quote" }]
}
{% endschema %}