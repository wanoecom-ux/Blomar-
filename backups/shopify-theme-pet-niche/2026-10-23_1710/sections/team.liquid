<section class="section team sec-scope" id="{{ section.settings.anchor | handleize }}" style="--team-bg: {{ section.settings.bg }}; {% render 'section-vars', s: section.settings %}">
  <div class="page-width">
    <div class="section-head center">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow eyebrow--accent">{{ section.settings.eyebrow | replace: '[', '<span class="hl">' | replace: ']', '</span>' }}</p>{%- endif -%}
      <h2 class="h2">{{ section.settings.heading | replace: '[', '<span class="hl">' | replace: ']', '</span>' }}</h2>
      {%- if section.settings.text != blank -%}<div class="muted narrow rte">{{ section.settings.text | replace: '[', '<span class="hl">' | replace: ']', '</span>' }}</div>{%- endif -%}
    </div>
    {%- if section.settings.group_photo -%}
      <div class="team__group">{{ section.settings.group_photo | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '800,1200,1600', sizes: '(min-width: 990px) 1000px, 100vw', alt: section.settings.heading }}</div>
    {%- endif -%}
    <div class="team__grid">
      {%- for block in section.blocks -%}
        <article class="team__card" {{ block.shopify_attributes }}>
          <div class="team__photo">
            {%- if block.settings.photo -%}{{ block.settings.photo | image_url: width: 600 | image_tag: loading: 'lazy', alt: block.settings.name }}{%- else -%}{{ 'image' | placeholder_svg_tag: 'placeholder' }}{%- endif -%}
          </div>
          <h3 class="h4">{{ block.settings.name }}</h3>
          {%- if block.settings.role != blank -%}<p class="team__role">{{ block.settings.role }}</p>{%- endif -%}
          {%- if block.settings.bio != blank -%}<p class="small muted">{{ block.settings.bio | replace: '[', '<span class="hl">' | replace: ']', '</span>' }}</p>{%- endif -%}
          {%- if block.settings.pet != blank -%}<p class="small team__pet">{% render 'icon', name: 'paw', size: 14 %} {{ block.settings.pet }}</p>{%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>
<style>
.team{background:var(--team-bg)}
.team__group{border-radius:var(--radius);overflow:hidden;margin:0 auto 32px;max-width:1000px}
.team__grid{display:grid;gap:20px;grid-template-columns:repeat(2,1fr)}
@media (min-width:990px){.team__grid{grid-template-columns:repeat(4,1fr)}}
.team__card{text-align:center}
.team__photo{aspect-ratio:1/1;border-radius:50%;overflow:hidden;max-width:180px;margin:0 auto 14px;background:var(--color-card)}
.team__photo img,.team__photo svg{width:100%;height:100%;object-fit:cover}
.team__card .h4{margin:0 0 2px}
.team__role{color:var(--color-accent);font-weight:var(--font-body-weight-bold);font-size:.85rem;margin:0 0 6px}
.team__pet{display:inline-flex;align-items:center;gap:6px;margin:0;color:var(--color-muted)}
</style>
{% schema %}
{"name":"Meet the team","settings":[{"type":"text","id":"anchor","label":"Anchor ID","default":"team"},{"type":"color","id":"bg","label":"Background","default":"#FFFFFF"},{"type":"text","id":"eyebrow","label":"Small label","default":"The people behind Blomar"},{"type":"text","id":"heading","label":"Heading","default":"Meet the team","info":"Put [square brackets] around words to highlight them."},{"type":"richtext","id":"text","label":"Text","default":"<p>We're dog people first. Every product we sell is one we'd use with our own pets.</p>"},{"type":"image_picker","id":"group_photo","label":"Group photo (optional)"},{"type":"header","content":"Colours"},{"type":"paragraph","content":"Leave any colour empty to use the theme colours."},{"type":"color","id":"c_text","label":"Text"},{"type":"color","id":"c_heading","label":"Headings"},{"type":"color","id":"c_accent","label":"Accent (buttons, ticks, icons, highlights)"},{"type":"color","id":"c_btn_text","label":"Button text"},{"type":"color","id":"c_shadow","label":"Card & button shadow"}],"blocks":[{"type":"member","name":"Team member","settings":[{"type":"image_picker","id":"photo","label":"Photo"},{"type":"text","id":"name","label":"Name","default":"Name"},{"type":"text","id":"role","label":"Role","default":"Role"},{"type":"textarea","id":"bio","label":"Short bio"},{"type":"text","id":"pet","label":"Their pet","info":"e.g. Dad to Max, a 4-year-old kelpie"}]}],"max_blocks":12,"presets":[{"name":"Meet the team","blocks":[{"type":"member"},{"type":"member"},{"type":"member"},{"type":"member"}]}]}
{% endschema %}