{%- comment -%}
  Rating line. style 'stars' = plain stars, e.g. ★★★★★ (4.8) 1,234 Reviews; style 'boxes' = star-in-box style.
  The rating and count come from the review app on the chosen product unless count_text is typed in.
  Usage: {% render 'rating-badge', p: product, style: 'stars', label: ..., count_text: ..., color: ..., text_color: ... %}
{%- endcomment -%}
{%- liquid
  assign r = 5
  assign n = 0
  assign has_r = false
  if p != blank and p.metafields.reviews.rating.value != blank
    assign r = p.metafields.reviews.rating.value.rating | times: 1.0
    assign n = p.metafields.reviews.rating_count | times: 1
    assign has_r = true
  endif
  assign shown = count_text
  if shown == blank and n > 0
    if style == 'stars'
      assign shown = n | append: ' Reviews'
    else
      assign shown = '(' | append: n | append: ' reviews)'
    endif
  endif
  assign lbl = label
  if style == 'stars' and lbl == blank and has_r
    assign lbl = r | round: 1 | prepend: '(' | append: ')'
  endif
  assign c = color
  if style == 'stars' and c == blank
    assign c = settings.color_star
  endif
-%}
<div class="rbadge{% if style == 'stars' %} rbadge--stars{% endif %}" style="--rb-box: {{ c | default: '#1F9D55' }}; --rb-text: {{ text_color | default: 'currentColor' }};">
  <span class="rbadge__stars" role="img" aria-label="{{ r | round: 1 }} out of 5 stars">
    {%- for i in (1..5) -%}
      {%- assign prev = i | minus: 1 -%}
      {%- assign fill = 0 -%}
      {%- if r >= i -%}{%- assign fill = 100 -%}{%- elsif r > prev -%}{%- assign fill = r | minus: prev | times: 100 | round -%}{%- endif -%}
      {%- if style == 'stars' -%}
        <span class="rbadge__star" style="--rb-fill: {{ fill }}%;"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="m12 2.8 2.8 5.8 6.3.9-4.6 4.4 1.1 6.3L12 17.2l-5.6 3 1.1-6.3-4.6-4.4 6.3-.9L12 2.8Z"/></svg></span>
      {%- else -%}
        <span class="rbadge__box" style="--rb-fill: {{ fill }}%;"><svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path fill="#fff" d="m12 2.8 2.8 5.8 6.3.9-4.6 4.4 1.1 6.3L12 17.2l-5.6 3 1.1-6.3-4.6-4.4 6.3-.9L12 2.8Z"/></svg></span>
      {%- endif -%}
    {%- endfor -%}
  </span>
  {%- if lbl != blank or shown != blank -%}<span class="rbadge__text">{% if lbl != blank %}<strong>{{ lbl }}</strong>{% endif %} {{ shown }}</span>{%- endif -%}
</div>
<style>
.rbadge{display:inline-flex;align-items:center;gap:10px;flex-wrap:wrap;color:var(--rb-text);font-size:.9rem}
.rbadge__stars{display:inline-flex;gap:3px}
.rbadge__box{display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;background:linear-gradient(90deg,var(--rb-box) var(--rb-fill),#DCDCE6 var(--rb-fill))}
.rbadge--stars{gap:8px}
.rbadge--stars .rbadge__stars{gap:1px}
.rbadge__star{display:inline-flex;width:18px;height:18px}
.rbadge__star svg{width:100%;height:100%;fill:var(--rb-box);-webkit-mask:linear-gradient(90deg,#000 var(--rb-fill),rgba(0,0,0,.25) var(--rb-fill));mask:linear-gradient(90deg,#000 var(--rb-fill),rgba(0,0,0,.25) var(--rb-fill))}
.rbadge__text strong{font-weight:var(--font-body-weight-medium)}
.rbadge--stars .rbadge__text strong{font-weight:var(--font-body-weight-bold)}
</style>
