{%- liquid
  assign target = variant | default: product.selected_or_first_available_variant
  assign show_from = show_from | default: false
-%}
<span class="price{% if target.compare_at_price > target.price %} price--sale{% endif %}">
  {%- if show_from and product.price_varies -%}<span class="price__from">{{ 'products.from' | t }}</span> {%- endif -%}
  <span class="price__now">{{ target.price | money }}</span>
  {%- if target.compare_at_price > target.price -%}
    <s class="price__was">{{ target.compare_at_price | money }}</s>
  {%- endif -%}
</span>