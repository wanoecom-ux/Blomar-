{%- liquid
  assign s = section.settings
  assign rows = s.links | newline_to_br | split: '<br />'
-%}
<header class="nph">
  <div class="page-width nph__bar">
    <button type="button" class="nph__burger" data-menu-open aria-label="Open menu">{% render 'np-icon', name: 'menu', size: 24 %}</button>
    <a class="nph__logo" href="{{ s.logo_link | default: routes.root_url }}" style="--logo-w: {{ s.logo_width }}px;">{%- if s.logo != blank -%}{{ s.logo | image_url: width: 400 | image_tag: alt: shop.name }}{%- else -%}<img src="{{ 'blomar-logo-navy.png' | asset_url }}" alt="{{ shop.name | escape }}" width="1112" height="255">{%- endif -%}</a>
    <nav class="nph__nav" aria-label="Main">{%- for r in rows -%}{%- assign p = r | strip | split: '|' -%}{%- if p.size == 2 -%}<a href="{{ p[1] | strip }}">{{ p[0] | strip | escape }}</a>{%- endif -%}{%- endfor -%}</nav>
    <div class="nph__icons">
      <a href="{{ routes.search_url }}" class="nph__ico" aria-label="Search">{% render 'np-icon', name: 'search', size: 22 %}</a>
      <a href="{{ routes.account_url }}" class="nph__ico nph__acct" aria-label="Account">{% render 'np-icon', name: 'user', size: 22 %}</a>
      <button type="button" class="nph__ico" data-cart-open aria-label="Open cart">{% render 'np-icon', name: 'cart', size: 22 %}<span class="hdr__count" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span></button>
    </div>
  </div>
  <div class="mnav" data-menu hidden><div class="mnav__head"><span></span><button type="button" data-menu-close aria-label="Close menu">{% render 'np-icon', name: 'close', size: 24 %}</button></div>
    <nav class="mnav__links">{%- for r in rows -%}{%- assign p = r | strip | split: '|' -%}{%- if p.size == 2 -%}<a href="{{ p[1] | strip }}">{{ p[0] | strip | escape }}</a>{%- endif -%}{%- endfor -%}</nav></div>
</header>
{% schema %}
{"name":"Header","settings":[{"type":"image_picker","id":"logo","label":"Logo"},{"type":"range","id":"logo_width","label":"Logo width","min":60,"max":220,"step":2,"unit":"px","default":130},{"type":"text","id":"logo_link","label":"Logo link","default":"/products/blomar-cervical-pillow"},{"type":"textarea","id":"links","label":"Links (Label | /url per line)","default":"Home | /\nCervical Pillow | /products/blomar-cervical-pillow\nTrack Your Order | /pages/track-your-order"}]}
{% endschema %}
