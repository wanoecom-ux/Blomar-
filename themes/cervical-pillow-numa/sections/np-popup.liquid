{%- assign s = section.settings -%}
{%- if s.enabled and s.code != blank -%}
<div class="nppop" data-np-popup data-delay="{{ s.delay }}" hidden>
  <div class="nppop__box" role="dialog" aria-modal="true" aria-labelledby="NpPopTitle">
    <button type="button" class="nppop__x" data-np-pop-close aria-label="Close">{% render 'np-icon', name: 'close', size: 20 %}</button>
    <img src="{{ 'blomar-logo-white.png' | asset_url }}" alt="{{ shop.name | escape }}" width="1112" height="255" class="nppop__logo">
    <h2 id="NpPopTitle">{{ s.heading | escape }}</h2>
    <div class="nppop__cards" data-np-pop-step="pick">{%- for i in (1..3) -%}<button type="button" class="nppop__card" data-np-pop-pick aria-label="Reveal offer {{ i }}">?</button>{%- endfor -%}</div>
    <div class="nppop__reveal" data-np-pop-step="code" hidden><p class="nppop__off">{{ s.offer | escape }}</p><p>Use code at checkout:</p><button type="button" class="nppop__code" data-np-pop-copy>{{ s.code | escape }}</button><a class="np-btn np-btn--light" href="/discount/{{ s.code | url_encode }}?redirect={{ request.path | url_encode }}" data-np-pop-apply>Apply and keep shopping</a></div>
  </div>
</div>
{%- endif -%}
{% schema %}
{"name":"Discount reveal pop-up","settings":[{"type":"checkbox","id":"enabled","label":"Enable","default":false},{"type":"text","id":"code","label":"Real discount code (create it in Discounts first)","info":"Pop-up stays off until a code is entered."},{"type":"text","id":"offer","label":"Offer text","default":"REPLACE_ME% OFF"},{"type":"text","id":"heading","label":"Heading","default":"Pick one to reveal your offer"},{"type":"range","id":"delay","label":"Show after (seconds)","min":0,"max":30,"step":1,"default":6}],"presets":[{"name":"Discount reveal pop-up"}]}
{% endschema %}
