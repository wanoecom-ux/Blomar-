<section class="npfaq" id="faq" style="--sec-bg: {{ section.settings.bg }};"><div class="page-width npfaq__in">
  <h2 class="np-h2 np-h2--brand np-center">{{ section.settings.heading | escape }}</h2>
  {%- for block in section.blocks -%}<details class="np-acc-row" {{ block.shopify_attributes }}><summary>{{ block.settings.q | escape }}<span class="np-plus">{% render 'np-icon', name: 'plus', size: 14 %}</span></summary><div class="rte">{{ block.settings.a }}</div></details>{%- endfor -%}
</div></section>
{% schema %}
{"name":"FAQ","settings":[{"type":"color","id":"bg","label":"Background","default":"#FFFFFF"},{"type":"text","id":"heading","label":"Heading","default":"FAQ"}],"blocks":[{"type":"q","name":"Question","settings":[{"type":"text","id":"q","label":"Question","default":"Question"},{"type":"richtext","id":"a","label":"Answer","default":"<p>Answer</p>"}]}],"presets":[{"name":"FAQ"}]}
{% endschema %}
