<div class="npa" style="--npa-bg: {{ section.settings.bg }}; --npa-fg: {{ section.settings.fg }};"><div class="page-width npa__in">{{ section.settings.text | escape | replace: '[', '<strong>' | replace: ']', '</strong>' }}</div></div>
{% schema %}
{"name":"Announcement bar","settings":[{"type":"text","id":"text","label":"Message","default":"[Free shipping] on every order · 30-night sleep trial","info":"[Brackets] = bold."},{"type":"color","id":"bg","label":"Background","default":"#2F2756"},{"type":"color","id":"fg","label":"Text","default":"#FFFFFF"}]}
{% endschema %}
