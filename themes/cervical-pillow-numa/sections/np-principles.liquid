{%- assign s = section.settings -%}
<section class="npp" style="--sec-bg: {{ s.bg }};"><div class="page-width npp__grid">
  <div class="npp__copy"><h2 class="np-h2 np-h2--brand">{{ s.heading | escape }}</h2><p>{{ s.text | escape }}</p>
    {%- for block in section.blocks -%}<details class="np-acc-row np-acc-row--soft" {{ block.shopify_attributes }}><summary>{{ block.settings.title | escape }}<span class="np-plus np-plus--plain">{% render 'np-icon', name: 'plus', size: 16 %}</span></summary><div class="rte">{{ block.settings.text }}</div></details>{%- endfor -%}
    {%- if s.note != blank -%}<p class="np-note"><em>{{ s.note | escape }}</em></p>{%- endif -%}</div>
  <div class="npp__img">{% render 'media-img', image: s.image, width: 1100, alt: s.heading %}</div>
</div></section>
{% schema %}
{"name":"Text + accordions + image","settings":[{"type":"color","id":"bg","label":"Background","default":"#FFFFFF"},{"type":"text","id":"heading","label":"Heading","default":"Heading"},{"type":"textarea","id":"text","label":"Text","default":"Text"},{"type":"image_picker","id":"image","label":"Image (REPLACE_ME)"},{"type":"textarea","id":"note","label":"Small print"}],"blocks":[{"type":"row","name":"Row","settings":[{"type":"text","id":"title","label":"Title","default":"Row"},{"type":"richtext","id":"text","label":"Text","default":"<p>Text</p>"}]}],"presets":[{"name":"Text + accordions + image"}]}
{% endschema %}
