<div class="cd" id="CartDrawer" aria-hidden="true">
  <div class="cd__overlay" data-cart-close></div>
  <aside class="cd__panel" role="dialog" aria-modal="true" aria-label="Your cart">
    <header class="cd__head">
      <h2 class="cd__title">Your Cart</h2>
      <button type="button" class="cd__close" data-cart-close aria-label="Close">{% render 'icon', name: 'close' %}</button>
    </header>
    <div class="cd__body" data-cart-body></div>
    <footer class="cd__foot" data-cart-foot hidden>
      <div class="cd__total"><span>Subtotal</span><strong data-cart-total></strong></div>
      <p class="cd__tax">Taxes and shipping calculated at checkout.</p>
      <a class="btn btn--brand btn--block" href="/checkout">Checkout</a>
    </footer>
  </aside>
</div>
