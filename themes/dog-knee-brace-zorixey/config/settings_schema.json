[
 {
  "name": "theme_info",
  "theme_name": "Blomar Pet Brace",
  "theme_version": "1.0.0",
  "theme_author": "Blomar",
  "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
  "theme_support_url": "https://help.shopify.com/"
 },
 {
  "name": "Typography",
  "settings": [
   {
    "type": "font_picker",
    "id": "type_heading_font",
    "label": "Headings",
    "default": "poppins_n7"
   },
   {
    "type": "font_picker",
    "id": "type_body_font",
    "label": "Body",
    "default": "poppins_n4"
   }
  ]
 },
 {
  "name": "Colors",
  "settings": [
   {
    "type": "color",
    "id": "color_brand",
    "label": "Accent (buttons, highlights)",
    "default": "#2C4A3E"
   },
   {
    "type": "color",
    "id": "color_brand_dark",
    "label": "Dark brown",
    "default": "#174D27"
   },
   {
    "type": "color",
    "id": "color_tint",
    "label": "Cream section",
    "default": "#FAF6F0"
   },
   {
    "type": "color",
    "id": "color_pill",
    "label": "Soft card",
    "default": "#E9EDEB"
   },
   {
    "type": "color",
    "id": "color_text",
    "label": "Headings",
    "default": "#2C2C2C"
   },
   {
    "type": "color",
    "id": "color_muted",
    "label": "Body text",
    "default": "#4A4A4A"
   },
   {
    "type": "color",
    "id": "color_bg",
    "label": "Background",
    "default": "#FFFFFF"
   },
   {
    "type": "color",
    "id": "color_sale",
    "label": "Green badge",
    "default": "#D43737"
   },
   {
    "type": "color",
    "id": "color_highlight",
    "label": "[Bracket] word colour",
    "default": "#233A2F"
   }
  ]
 },
 {
  "name": "Layout",
  "settings": [
   {
    "type": "range",
    "id": "page_width",
    "label": "Page width",
    "min": 1000,
    "max": 1600,
    "step": 20,
    "unit": "px",
    "default": 1320
   }
  ]
 },
 {
  "name": "Brand",
  "settings": [
   {
    "type": "image_picker",
    "id": "favicon",
    "label": "Favicon"
   }
  ]
 },
 {
  "name": "Search engines",
  "settings": [
   {
    "type": "checkbox",
    "id": "noindex",
    "label": "Hide this theme's pages from search engines",
    "default": true
   }
  ]
 }
]