<dialog class="zsg" id="size-guide" aria-label="{{ section.settings.heading | escape }}"><div class="zsg__inner"><button type="button" class="zsg__x" data-dlg-close aria-label="Close">{% render 'icon', name: 'close' %}</button><h2 class="zh2">{{ section.settings.heading | escape }}</h2><div class="zsg__img">{% render 'media-img', image: section.settings.image, width: 1200, alt: '' %}</div><div class="rte">{{ section.settings.text }}</div></div></dialog>
{% schema %}
{"name":"Size guide popup","settings":[{"type":"text","id":"heading","label":"Heading","default":"Size Guide"},{"type":"image_picker","id":"image","label":"Size chart image"},{"type":"richtext","id":"text","label":"Text","default":"<p>Measure your dog's thigh circumference and weight, then choose the size from the chart.</p>"}],"presets":[{"name":"Size guide popup"}]}
{% endschema %}
