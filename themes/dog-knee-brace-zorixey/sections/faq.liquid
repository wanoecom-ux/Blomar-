<section class="zfaq" id="faq"><div class="page-width zfaq__inner"><p class="z2p__eye">FREQUENTLY ASKED QUESTIONS</p><h2 class="zh2">{{ section.settings.heading | escape | replace: '[', '<span class="hl">' | replace: ']', '</span>' }}</h2>
{%- for block in section.blocks -%}<details class="zp__acc" {{ block.shopify_attributes }}><summary><span>?</span>{{ block.settings.q | escape | replace: '[', '<span class="hl">' | replace: ']', '</span>' }}{% render 'icon', name: 'chevron-down', size: 16 %}</summary><div class="rte">{{ block.settings.a  | replace: '[', '<span class="hl">' | replace: ']', '</span>' }}</div></details>{%- endfor -%}</div></section>
{% schema %}
{"name":"FAQ","settings":[{"type":"text","id":"heading","label":"Heading","default":"FAQ"}],"blocks":[{"type":"q","name":"Question","settings":[{"type":"text","id":"q","label":"Question","default":"Question"},{"type":"richtext","id":"a","label":"Answer","default":"<p>Answer</p>"}]}],"presets":[{"name":"FAQ"}]}
{% endschema %}
