<section class="zt"><div class="page-width"><h2 class="zh2">{{ section.settings.heading | escape }}</h2>
<div class="zt__grid">{%- for block in section.blocks -%}<article class="zt__card" {{ block.shopify_attributes }}><div class="zt__img">{% render 'media-img', image: block.settings.image, width: 700, alt: '' %}<span class="zt__q">❝</span></div><p class="zt__stars">★★★★★</p><h3>{{ block.settings.title | escape }}</h3><p>“{{ block.settings.text | escape }}”</p><b>{{ block.settings.name | escape }}</b></article>{%- endfor -%}</div></div></section>
{% schema %}
{"name":"Testimonial cards","settings":[{"type":"text","id":"heading","label":"Heading","default":"Loved by Dog Owners"}],
"blocks":[{"type":"card","name":"Card","settings":[{"type":"image_picker","id":"image","label":"Photo"},{"type":"text","id":"title","label":"Title","default":"Title"},{"type":"textarea","id":"text","label":"Review","default":"[Add a real customer review here.]"},{"type":"text","id":"name","label":"Name","default":"Customer name"}]}],"presets":[{"name":"Testimonial cards"}]}
{% endschema %}
