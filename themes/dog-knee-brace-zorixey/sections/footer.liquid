<footer class="zf">
<svg class="zf__wave" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true"><path d="M0 40 C 240 0 480 0 720 36 C 960 72 1200 72 1440 30 L1440 80 L0 80 Z" fill="currentColor"/></svg>
<div class="zf__body"><div class="page-width zf__inner">
<h2 class="zf__h">{{ section.settings.heading | escape | replace: '[', '<span class="hl">' | replace: ']', '</span>' }}</h2>
<ul class="zf__links" role="list"><li><a href="/pages/contact">Contact Information</a></li><li><a href="/pages/track-your-order">Track Your Order</a></li>{%- for policy in shop.policies -%}<li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>{%- endfor -%}</ul>
{%- if section.settings.facebook != blank or section.settings.instagram != blank -%}<div class="zf__social">{%- if section.settings.facebook != blank -%}<a href="{{ section.settings.facebook }}" aria-label="Facebook"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M14 8h3V4h-3c-2.8 0-4 1.8-4 4.5V11H7v4h3v9h4v-9h3l1-4h-4V8.6c0-.4.3-.6.6-.6z"/></svg></a>{%- endif -%}{%- if section.settings.instagram != blank -%}<a href="{{ section.settings.instagram }}" aria-label="Instagram"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg></a>{%- endif -%}</div>{%- endif -%}
<p class="zf__note">{{ section.settings.text | escape | replace: '[', '<span class="hl">' | replace: ']', '</span>' }}</p>
<p class="zf__copy">&copy; {{ 'now' | date: '%Y' }} Blomar</p></div></div></footer>
{% schema %}
{"name":"Footer","settings":[{"type":"text","id":"heading","label":"Heading","default":"Customer Care"},{"type":"text","id":"facebook","label":"Facebook URL"},{"type":"text","id":"instagram","label":"Instagram URL"},{"type":"textarea","id":"text","label":"Small print","default":"Supportive gear for dogs who deserve to move freely. Not a substitute for veterinary care."}],"presets":[{"name":"Footer"}]}
{% endschema %}
