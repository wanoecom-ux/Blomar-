<section class="zrv" id="reviews"><div class="page-width"><h2 class="zrv__h">{{ section.settings.heading | escape }}</h2>
{%- for block in section.blocks -%}{%- if block.type == '@app' -%}{% render block %}{%- continue -%}{%- endif -%}<article class="zrv__item" {{ block.shopify_attributes }}><p class="zrv__stars">★★★★★</p><p class="zrv__name"><span>{{ block.settings.name | slice: 0 }}</span>{{ block.settings.name | escape }}</p><p>{{ block.settings.text | escape }}</p></article>{%- endfor -%}</div></section>
{% schema %}
{"name":"Customer reviews","settings":[{"type":"text","id":"heading","label":"Heading","default":"Customer Reviews"}],"blocks":[{"type":"@app"},{"type":"review","name":"Review","settings":[{"type":"text","id":"name","label":"Name","default":"Customer name"},{"type":"textarea","id":"text","label":"Review","default":"[Add a real customer review here.]"}]}],"presets":[{"name":"Customer reviews"}]}
{% endschema %}
