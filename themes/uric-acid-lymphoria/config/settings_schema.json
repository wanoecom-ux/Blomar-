[
 {
  "name": "theme_info",
  "theme_name": "Blomar Uric Acid",
  "theme_version": "1.0.0",
  "theme_author": "Blomar",
  "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
  "theme_support_url": "https://help.shopify.com/"
 },
 {
  "name": "Typography",
  "settings": [
   {
    "type": "font_picker",
    "id": "type_heading_font",
    "label": "Headings",
    "default": "helvetica_n7"
   },
   {
    "type": "font_picker",
    "id": "type_body_font",
    "label": "Body",
    "default": "helvetica_n4"
   }
  ]
 },
 {
  "name": "Colors",
  "settings": [
   {
    "type": "color",
    "id": "color_brand",
    "label": "Accent (buttons, highlights)",
    "default": "#0E5A36"
   },
   {
    "type": "color",
    "id": "color_brand_dark",
    "label": "Dark brown",
    "default": "#083D24"
   },
   {
    "type": "color",
    "id": "color_tint",
    "label": "Cream section",
    "default": "#E9F7F0"
   },
   {
    "type": "color",
    "id": "color_pill",
    "label": "Soft card",
    "default": "#F4FBF7"
   },
   {
    "type": "color",
    "id": "color_text",
    "label": "Headings",
    "default": "#000000"
   },
   {
    "type": "color",
    "id": "color_muted",
    "label": "Body text",
    "default": "#4B5563"
   },
   {
    "type": "color",
    "id": "color_bg",
    "label": "Background",
    "default": "#FFFFFF"
   },
   {
    "type": "color",
    "id": "color_sale",
    "label": "Green badge",
    "default": "#C62828"
   }
  ]
 },
 {
  "name": "Layout",
  "settings": [
   {
    "type": "range",
    "id": "page_width",
    "label": "Page width",
    "min": 1000,
    "max": 1600,
    "step": 20,
    "unit": "px",
    "default": 1160
   }
  ]
 },
 {
  "name": "Brand",
  "settings": [
   {
    "type": "image_picker",
    "id": "favicon",
    "label": "Favicon"
   }
  ]
 },
 {
  "name": "Search engines",
  "settings": [
   {
    "type": "checkbox",
    "id": "noindex",
    "label": "Hide this theme's pages from search engines",
    "default": true
   }
  ]
 }
]