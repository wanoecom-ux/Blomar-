<section class="upr">
  <div class="page-width upr__grid">
    <div><h2 class="uh2 uh2--left">{{ section.settings.heading | escape }}</h2><div class="rte upr__text">{{ section.settings.text }}</div>
      <ul class="upr__list" role="list">{%- assign rows = section.settings.bullets | split: '|' -%}{%- for r in rows -%}<li>{{ r | strip | escape }}</li>{%- endfor -%}</ul></div>
    <div class="upr__media">{% render 'media-img', image: section.settings.image, width: 1000, alt: '' %}</div>
  </div>
</section>
{% schema %}
{"name":"Problem / mechanism","settings":[{"type":"text","id":"heading","label":"Heading","default":"When Uric Acid Builds Up, Flares Follow"},{"type":"richtext","id":"text","label":"Text","default":"<p>Explain the problem.</p>"},{"type":"text","id":"bullets","label":"Bullets, separated by |","default":"Point one | Point two | Point three | Point four"},{"type":"image_picker","id":"image","label":"Image"}],"presets":[{"name":"Problem / mechanism"}]}
{% endschema %}
