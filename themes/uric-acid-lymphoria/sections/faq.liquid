<section class="ufq" id="faq">
  <div class="page-width ufq__inner">
    <h2 class="uh2 uh2--light">{{ section.settings.heading | escape }}</h2>
    <p class="ufq__sub">{{ section.settings.text | escape }}</p>
    {%- for block in section.blocks -%}<details class="ufq__q" {{ block.shopify_attributes }}><summary>{{ block.settings.question | escape }}<span>+</span></summary><div class="rte">{{ block.settings.answer }}</div></details>{%- endfor -%}
  </div>
</section>
{% schema %}
{"name":"FAQ","settings":[{"type":"text","id":"heading","label":"Heading","default":"Frequently Asked Questions"},{"type":"textarea","id":"text","label":"Text","default":"Straight answers to the questions we hear most."}],
"blocks":[{"type":"q","name":"Question","settings":[{"type":"text","id":"question","label":"Question","default":"Question"},{"type":"richtext","id":"answer","label":"Answer","default":"<p>Answer</p>"}]}],"presets":[{"name":"FAQ"}]}
{% endschema %}
