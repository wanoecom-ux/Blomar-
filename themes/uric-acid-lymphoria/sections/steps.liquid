<section class="ust">
  <div class="page-width">
    <h2 class="uh2 uh2--light">{{ section.settings.heading | escape }}</h2>
    <p class="ust__sub">{{ section.settings.text | escape }}</p>
    <div class="ust__grid">{%- for block in section.blocks -%}<div class="ust__step" {{ block.shopify_attributes }}><div class="ust__img">{% render 'media-img', image: block.settings.image, width: 600, alt: '' %}</div><div class="ust__card"><span>Step {{ forloop.index }}</span><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.text | escape }}</p></div></div>{%- endfor -%}</div>
  </div>
</section>
{% schema %}
{"name":"How-to steps","settings":[{"type":"text","id":"heading","label":"Heading","default":"The 2-Capsule Daily Routine"},{"type":"text","id":"text","label":"Text","default":"Simple, natural, and easy to stick with."}],
"blocks":[{"type":"step","name":"Step","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"title","label":"Title","default":"Step title"},{"type":"textarea","id":"text","label":"Text","default":"Step text."}]}],"presets":[{"name":"How-to steps"}]}
{% endschema %}
