{%- liquid
  assign s = section.settings
-%}
<section class="sc" style="--sec-bg: {{ s.bg }};" data-tabs>
  <div class="page-width">
    {%- if section.blocks.size > 1 -%}
      <div class="sc__tabs" role="tablist">
        {%- for block in section.blocks -%}
          <button type="button" role="tab" class="sc__tab{% if forloop.first %} is-active{% endif %}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" data-tab="{{ forloop.index0 }}" {{ block.shopify_attributes }}>{{ block.settings.tab | escape }}</button>
        {%- endfor -%}
      </div>
    {%- endif -%}
    {%- for block in section.blocks -%}
      {%- liquid
        assign pts = block.settings.points | split: ','
        assign labels = block.settings.labels | split: ','
        assign n = pts.size
        assign last = n | minus: 1
      -%}
      <div class="sc__panel{% if forloop.first %} is-active{% endif %}" role="tabpanel" data-panel="{{ forloop.index0 }}"{% unless forloop.first %} hidden{% endunless %}>
        <div class="sc__copy">
          <h2 class="sc__heading">{{ block.settings.heading | escape | replace: '[', '<strong>' | replace: ']', '</strong>' | replace: '((', '<em>' | replace: '))', '</em>' }}</h2>
          {%- assign items = block.settings.checklist | newline_to_br | split: '<br />' -%}
          <ul class="sc__list" role="list">
            {%- for item in items -%}{%- assign t = item | strip -%}{%- if t != blank -%}<li>{% render 'icon', name: 'check-circle', size: 20 %}<span>{{ t | escape }}</span></li>{%- endif -%}{%- endfor -%}
          </ul>
          {%- if s.button_label != blank -%}
            <a class="btn btn--brand sc__btn" href="{{ s.button_link | default: '#MainProduct' }}">{{ s.button_label | escape }} {% render 'icon', name: 'arrow', size: 15 %}</a>
          {%- endif -%}
        </div>
        <div class="sc__card">
          <div class="sc__card-head">
            <div><p class="sc__card-title">{{ block.settings.chart_title | escape }}</p><p class="sc__card-sub">{{ block.settings.chart_sub | escape }}</p></div>
            {%- if block.settings.badge != blank -%}<span class="sc__badge">↘ {{ block.settings.badge | escape }}</span>{%- endif -%}
          </div>
          <div class="sc__chart">
            <span class="sc__ylab">{{ block.settings.y_label | escape }}</span>
            <svg viewBox="0 0 400 220" preserveAspectRatio="none" class="sc__svg" aria-hidden="true">
              {%- for g in (0..4) -%}{%- assign gy = g | times: 50 | plus: 10 -%}<line x1="0" x2="400" y1="{{ gy }}" y2="{{ gy }}" class="sc__grid"/>{%- endfor -%}
              {%- capture path -%}{%- for p in pts -%}{%- assign v = p | strip | times: 1.0 -%}{%- assign x = forloop.index0 | times: 400.0 | divided_by: last -%}{%- assign y = 100.0 | minus: v | times: 2.0 | plus: 10 -%}{%- if forloop.first -%}M{{ x | round: 1 }} {{ y | round: 1 }}{%- else -%}{%- assign xm = px | plus: x | divided_by: 2.0 -%} C{{ xm | round: 1 }} {{ py | round: 1 }} {{ xm | round: 1 }} {{ y | round: 1 }} {{ x | round: 1 }} {{ y | round: 1 }}{%- endif -%}{%- assign px = x -%}{%- assign py = y -%}{%- endfor -%}{%- endcapture -%}
              <path d="{{ path }} L400 210 L0 210 Z" class="sc__area"/>
              <path d="{{ path }}" class="sc__line"/>
              {%- for p in pts -%}{%- assign v = p | strip | times: 1.0 -%}{%- assign x = forloop.index0 | times: 400.0 | divided_by: last -%}{%- assign y = 100.0 | minus: v | times: 2.0 | plus: 10 -%}<circle cx="{{ x | round: 1 }}" cy="{{ y | round: 1 }}" r="5" class="sc__dot"/>{%- endfor -%}
            </svg>
            <div class="sc__yaxis"><span>100%</span><span>75%</span><span>50%</span><span>25%</span><span>0%</span></div>
            <div class="sc__xaxis">{%- for l in labels -%}<span>{{ l | strip | escape }}</span>{%- endfor -%}</div>
          </div>
          <p class="sc__xlab">{{ block.settings.x_label | escape }}</p>
          {%- if block.settings.footnote != blank -%}<p class="sc__note">{{ block.settings.footnote | escape }}</p>{%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{"name":"Tabbed chart","settings":[
{"type":"text","id":"button_label","label":"Button label","default":"Get yours today"},
{"type":"text","id":"button_link","label":"Button link"},
{"type":"color","id":"bg","label":"Background","default":"#F0F6FF"}],
"blocks":[{"type":"tab","name":"Tab","settings":[
{"type":"text","id":"tab","label":"Tab label","default":"Joint Pressure"},
{"type":"textarea","id":"heading","label":"Heading","default":"[Take the pressure] off the joint and let it ((settle))","info":"[Square brackets] = bold, ((double round brackets)) = bold italic."},
{"type":"textarea","id":"checklist","label":"Checklist (one per line)","default":"Point one\nPoint two\nPoint three"},
{"type":"text","id":"chart_title","label":"Chart title","default":"Joint pressure"},
{"type":"text","id":"chart_sub","label":"Chart subtitle","default":"How it eases with daily use"},
{"type":"text","id":"badge","label":"Chart badge"},
{"type":"text","id":"points","label":"Line values 0–100, comma separated","default":"100,62,34,16"},
{"type":"text","id":"labels","label":"X-axis labels, comma separated","default":"Day 1,Day 3,Day 7,Day 14"},
{"type":"text","id":"y_label","label":"Y-axis label","default":"LEVEL"},
{"type":"text","id":"x_label","label":"X-axis title","default":"DAYS OF USE"},
{"type":"text","id":"footnote","label":"Small note under the chart","default":"Illustration of how relief typically builds, not clinical data."}]}],
"presets":[{"name":"Tabbed chart"}]}
{% endschema %}
