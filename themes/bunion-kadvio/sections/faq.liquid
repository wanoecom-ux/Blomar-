<section class="faq" id="{{ section.settings.anchor | default: 'faq' }}" style="--sec-bg: {{ section.settings.bg }};">
  <div class="page-width faq__inner">
    {%- if section.settings.heading != blank -%}<h2 class="faq__heading">{% render 'rich-heading', text: section.settings.heading %}</h2>{%- endif -%}
    {%- for block in section.blocks -%}
      <details class="acc" {{ block.shopify_attributes }}>
        <summary><span>{{ block.settings.question | escape }}</span>{% render 'icon', name: 'chevron-down' %}</summary>
        <div class="acc__body rte">{{ block.settings.answer }}</div>
      </details>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{"name":"FAQ","settings":[
{"type":"text","id":"heading","label":"Heading","default":"Frequently asked [questions]"},
{"type":"text","id":"anchor","label":"Anchor","default":"faq"},
{"type":"color","id":"bg","label":"Background","default":"#FFFFFF"}],
"blocks":[{"type":"question","name":"Question","settings":[{"type":"text","id":"question","label":"Question","default":"Question"},{"type":"richtext","id":"answer","label":"Answer","default":"<p>Answer</p>"}]}],
"presets":[{"name":"FAQ"}]}
{% endschema %}
