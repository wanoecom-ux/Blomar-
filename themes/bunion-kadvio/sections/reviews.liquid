{%- liquid
  assign s = section.settings
-%}
<section class="rv" id="reviews" style="--sec-bg: {{ s.bg }};">
  <div class="page-width">
    {%- if s.heading != blank -%}<h2 class="rv__heading">{% render 'rich-heading', text: s.heading %}</h2>{%- endif -%}
    {%- if s.subheading != blank -%}<p class="rv__sub">{{ s.subheading | escape }}</p>{%- endif -%}
    <div class="rv__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}{%- continue -%}{%- endif -%}
        <article class="rv__card" {{ block.shopify_attributes }}>
          {%- if block.settings.photo != blank -%}<div class="rv__photo">{{ block.settings.photo | image_url: width: 700 | image_tag: loading: 'lazy', alt: '' }}</div>{%- endif -%}
          <div class="rv__body">
            <p class="rv__stars">{%- for i in (1..5) -%}{% render 'icon', name: 'star', size: 15 %}{%- endfor -%}</p>
            <p class="rv__text">{{ block.settings.text | escape }}</p>
            <p class="rv__name">{{ block.settings.name | escape }}{% if block.settings.verified %} <span class="rv__verified">{% render 'icon', name: 'check-circle', size: 14 %} Verified</span>{% endif %}</p>
          </div>
        </article>
      {%- endfor -%}
    </div>
    {%- for block in section.blocks -%}{%- if block.type == '@app' -%}<div class="rv__app">{% render block %}</div>{%- endif -%}{%- endfor -%}
  </div>
</section>
{% schema %}
{"name":"Customer reviews","settings":[
{"type":"text","id":"heading","label":"Heading","default":"Customer [Reviews]"},
{"type":"text","id":"subheading","label":"Small line","default":"Real reviews from real customers."},
{"type":"color","id":"bg","label":"Background","default":"#FFFFFF"}],
"blocks":[{"type":"review","name":"Review","settings":[
{"type":"image_picker","id":"photo","label":"Customer photo"},
{"type":"textarea","id":"text","label":"Review","default":"[Add a real customer review here.]"},
{"type":"text","id":"name","label":"Name","default":"Customer name"},
{"type":"checkbox","id":"verified","label":"Verified badge","default":true}]},{"type":"@app"}],
"presets":[{"name":"Customer reviews"}]}
{% endschema %}
