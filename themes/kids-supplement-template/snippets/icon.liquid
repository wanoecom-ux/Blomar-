{%- when 'sparkle' -%}<svg viewBox="0 0 24 24" width="{{ size | default: 24 }}" height="{{ size | default: 24 }}" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><path d="M12 3c.6 4.6 2.4 6.4 7 7-4.6.6-6.4 2.4-7 7-.6-4.6-2.4-6.4-7-7 4.6-.6 6.4-2.4 7-7Z"/></svg>
{%- when 'arrow' -%}<svg viewBox="0 0 24 24" width="{{ size | default: 16 }}" height="{{ size | default: 16 }}" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
{%- when 'chevron-right' -%}<svg viewBox="0 0 24 24" width="{{ size | default: 16 }}" height="{{ size | default: 16 }}" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
{%- when 'chevron-down' -%}<svg viewBox="0 0 24 24" width="{{ size | default: 18 }}" height="{{ size | default: 18 }}" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
{%- when 'cart' -%}<svg viewBox="0 0 24 24" width="{{ size | default: 22 }}" height="{{ size | default: 22 }}" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 4h2.2l2.2 11h10.8l2-8H6.3"/><circle cx="9.5" cy="19" r="1.4"/><circle cx="17" cy="19" r="1.4"/><path d="M10 10h6M11 13h4"/></svg>
{%- when 'menu' -%}<svg viewBox="0 0 24 24" width="{{ size | default: 22 }}" height="{{ size | default: 22 }}" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
