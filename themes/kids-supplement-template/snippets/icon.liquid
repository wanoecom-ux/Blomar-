{%- when 'card' -%}<svg viewBox="0 0 24 24" width="{{ size | default: 24 }}" height="{{ size | default: 24 }}" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="M3 10h18M14 15h4"/></svg>
{%- when 'star' -%}<svg viewBox="0 0 24 24" width="{{ size | default: 24 }}" height="{{ size | default: 24 }}" fill="currentColor" aria-hidden="true"><path d="m12 2.8 2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17.2l-5.7 3.1 1.2-6.4-4.7-4.4 6.4-.8L12 2.8Z"/></svg>
{%- when 'check' -%}<svg viewBox="0 0 24 24" width="{{ size | default: 24 }}" height="{{ size | default: 24 }}" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 12.5 4 4 8-9"/></svg>
{%- when 'check-circle' -%}<svg viewBox="0 0 24 24" width="{{ size | default: 24 }}" height="{{ size | default: 24 }}" aria-hidden="true"><circle cx="12" cy="12" r="11" fill="currentColor"/><path d="m7 12.5 3.3 3.3L17 9" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
{%- when 'shield' -%}<svg viewBox="0 0 24 24" width="{{ size | default: 24 }}" height="{{ size | default: 24 }}" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 5 6v5.5c0 4.4 3 8 7 9.5 4-1.5 7-5.1 7-9.5V6l-7-3Z"/><path d="m9 12 2 2 4-4"/></svg>
