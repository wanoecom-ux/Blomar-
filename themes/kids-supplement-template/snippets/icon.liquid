{%- when 'clock' -%}<svg viewBox="0 0 24 24" width="{{ size | default: 14 }}" height="{{ size | default: 14 }}" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
{%- when 'return' -%}<svg viewBox="0 0 24 24" width="{{ size | default: 16 }}" height="{{ size | default: 16 }}" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 4v12a4 4 0 0 0 4 4h0"/><path d="M8 4h6l-2 3 2 3H8"/></svg>
