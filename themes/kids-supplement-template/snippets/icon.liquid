{%- when 'send' -%}<svg viewBox="0 0 24 24" width="{{ size | default: 40 }}" height="{{ size | default: 40 }}" fill="currentColor" aria-hidden="true"><path d="M21 3 3 10.5l7 2.5 2.5 7L21 3Z"/></svg>
{%- when 'track' -%}<svg viewBox="0 0 48 48" width="{{ size | default: 36 }}" height="{{ size | default: 36 }}" aria-hidden="true"><path d="M24 6 8 13v18l16 7 16-7V13L24 6Z" fill="#eceef1" stroke="#9aa3ad" stroke-width="1.5"/><path d="m8 13 16 7 16-7M24 20v18" fill="none" stroke="#9aa3ad" stroke-width="1.5"/><circle cx="34" cy="32" r="7" fill="#1a1a1a"/><circle cx="33" cy="31" r="3" fill="none" stroke="#fff" stroke-width="1.6"/><path d="m35.5 33.5 2 2" stroke="#fff" stroke-width="1.6" stroke-linecap="round"/></svg>
{%- when 'exchange' -%}<svg viewBox="0 0 48 48" width="{{ size | default: 36 }}" height="{{ size | default: 36 }}" aria-hidden="true"><path d="M24 6 8 13v18l16 7 16-7V13L24 6Z" fill="#eceef1" stroke="#9aa3ad" stroke-width="1.5"/><path d="m8 13 16 7 16-7M24 20v18" fill="none" stroke="#9aa3ad" stroke-width="1.5"/><circle cx="34" cy="32" r="7" fill="#1a1a1a"/><path d="M31 32a3 3 0 1 0 1-2.2M31 28.5v2h2" fill="none" stroke="#fff" stroke-width="1.5" stroke-linecap="round"/></svg>
{%- when 'cancel' -%}<svg viewBox="0 0 48 48" width="{{ size | default: 36 }}" height="{{ size | default: 36 }}" aria-hidden="true"><path d="M24 6 8 13v18l16 7 16-7V13L24 6Z" fill="#eceef1" stroke="#9aa3ad" stroke-width="1.5"/><path d="m8 13 16 7 16-7M24 20v18" fill="none" stroke="#9aa3ad" stroke-width="1.5"/><circle cx="34" cy="32" r="7" fill="#1a1a1a"/><path d="m31.5 29.5 5 5M36.5 29.5l-5 5" stroke="#fff" stroke-width="1.6" stroke-linecap="round"/></svg>
{%- else -%}<svg viewBox="0 0 24 24" width="{{ size | default: 24 }}" height="{{ size | default: 24 }}" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="12" r="8"/></svg>
