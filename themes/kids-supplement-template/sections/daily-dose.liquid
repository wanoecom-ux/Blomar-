<section class="ks ks--cream">
  <div class="page-width">
    <p class="eyebrow eyebrow--center">{{ section.settings.eyebrow | escape }}</p>
    <h2 class="kh2 kh2--center">{% render 'hl', text: section.settings.heading %}</h2>
    <div class="dd__grid">
      <div class="dd__media">{% render 'media-img', image: section.settings.image, width: 1000, alt: '' %}</div>
      <div><h3 class="dd__h">{{ section.settings.card_heading | escape }}</h3>
        <div class="dd__card"><div class="dd__top"><strong>{{ section.settings.who | escape }}</strong>{%- if section.settings.badge != blank -%}<span>{{ section.settings.badge | escape }}</span>{%- endif -%}</div><p class="dd__dose">{{ section.settings.dose | escape }}</p><p>{{ section.settings.text | escape }}</p></div>
        {%- if section.settings.tip != blank -%}<p class="dd__tip">ⓘ {{ section.settings.tip | escape }}</p>{%- endif -%}</div>
    </div>
  </div>
</section>
{% schema %}
{"name":"Daily dose card","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"HOW TO USE"},{"type":"text","id":"heading","label":"Heading","default":"Simple Daily Routine. [Consistent Results.]"},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"card_heading","label":"Card heading","default":"The Daily Dose"},{"type":"text","id":"who","label":"Who","default":"🧒 Children (Ages 4–12)"},{"type":"text","id":"badge","label":"Badge","default":"RECOMMENDED"},{"type":"text","id":"dose","label":"Dose line","default":"1 gummy per day · 30-day supply"},{"type":"textarea","id":"text","label":"Text","default":"How and when to take it."},{"type":"textarea","id":"tip","label":"Tip","default":"Tip: give it at the same time each day to build a routine."}],"presets":[{"name":"Daily dose card"}]}
{% endschema %}
