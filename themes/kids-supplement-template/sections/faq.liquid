<section class="ks ks--cream" id="faq">
  <div class="page-width kfaq">
    <h2 class="kh2 kh2--center">{% render 'hl', text: section.settings.heading %}</h2>
    {%- for block in section.blocks -%}<details class="kp__q kfaq__q" {{ block.shopify_attributes }}><summary>{{ block.settings.question | escape }}<span>+</span></summary><div>{{ block.settings.answer }}</div></details>{%- endfor -%}
  </div>
</section>
{% schema %}
{"name":"FAQ","settings":[{"type":"text","id":"heading","label":"Heading","default":"Frequently Asked [Questions]"}],
"blocks":[{"type":"q","name":"Question","settings":[{"type":"text","id":"question","label":"Question","default":"Question"},{"type":"richtext","id":"answer","label":"Answer","default":"<p>Answer</p>"}]}],
"presets":[{"name":"FAQ","blocks":[{"type":"q"},{"type":"q"},{"type":"q"}]}]}
{% endschema %}
