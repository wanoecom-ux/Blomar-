<section class="ks ks--white">
  <div class="page-width">
    <p class="eyebrow eyebrow--center">✓ {{ section.settings.eyebrow | escape }}</p>
    <h2 class="kh2 kh2--center">{% render 'hl', text: section.settings.heading %}</h2>
    {%- if section.settings.sub != blank -%}<p class="ktext ktext--center ex__sub">{{ section.settings.sub | escape }}</p>{%- endif -%}
    <div class="ex">
      <div class="ex__who">{% render 'media-img', image: section.settings.photo, width: 200, class: 'ex__img', alt: '' %}<strong>{{ section.settings.name | escape }}</strong><span>{{ section.settings.role | escape }}</span></div>
      <div class="ex__body"><h3>{{ section.settings.title | escape }}</h3><blockquote>{{ section.settings.quote | escape }}</blockquote>
        <p class="ex__hl-label">HIGHLIGHTS:</p><div class="ex__tags">{%- assign tags = section.settings.tags | split: '|' -%}{%- for t in tags -%}<span>♡ {{ t | strip | escape }}</span>{%- endfor -%}</div></div>
    </div>
  </div>
</section>
{% schema %}
{"name":"Expert quote","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"EXPERT REVIEWED"},{"type":"text","id":"heading","label":"Heading","default":"What Experts Say About [Our Gummies]"},{"type":"text","id":"sub","label":"Small line"},{"type":"image_picker","id":"photo","label":"Photo"},{"type":"text","id":"name","label":"Name","default":"[Expert name, credentials]","info":"Only use a real, consenting expert."},{"type":"text","id":"role","label":"Role","default":"[Role]"},{"type":"text","id":"title","label":"Quote title","default":"[Quote headline]"},{"type":"textarea","id":"quote","label":"Quote","default":"[Add a real expert quote here.]"},{"type":"text","id":"tags","label":"Highlights, separated by |","default":"Highlight one | Highlight two | Highlight three"}],"presets":[{"name":"Expert quote"}]}
{% endschema %}
