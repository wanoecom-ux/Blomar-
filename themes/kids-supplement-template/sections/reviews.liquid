<section class="ks ks--white" id="reviews">
  <div class="page-width rvk">
    <div class="rvk__side"><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.sub | escape }}</p></div>
    <div class="rvk__list">
      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}{% render block %}{%- continue -%}{%- endif -%}
        <article class="rvk__item" {{ block.shopify_attributes }}><p class="rvk__stars">★★★★★</p><p class="rvk__name"><span>{{ block.settings.name | slice: 0 }}</span>{{ block.settings.name | escape }}</p><p>{{ block.settings.text | escape }}</p></article>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{"name":"Customer reviews","settings":[{"type":"text","id":"heading","label":"Heading","default":"Customer Reviews"},{"type":"text","id":"sub","label":"Small line","default":"Add a reviews app block here, or real reviews below."}],
"blocks":[{"type":"@app"},{"type":"review","name":"Review","settings":[{"type":"text","id":"name","label":"Name","default":"Customer name"},{"type":"textarea","id":"text","label":"Review","default":"[Add a real customer review here.]"}]}],
"presets":[{"name":"Customer reviews","blocks":[{"type":"review"},{"type":"review"},{"type":"review"}]}]}
{% endschema %}
