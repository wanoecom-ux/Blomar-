<section class="ks ks--cream">
  <div class="page-width res__grid">
    <div class="res__media">{% render 'media-img', image: section.settings.image, width: 1000, alt: '' %}</div>
    <div>
      <h2 class="kh2">{% render 'hl', text: section.settings.heading %}</h2>
      <p class="ktext">{{ section.settings.text | escape }}</p>
      <div class="res__cards">{%- for block in section.blocks -%}<div class="res__card" {{ block.shopify_attributes }}><span class="res__ico">{{ block.settings.icon | escape }}</span><strong>{{ block.settings.figure | escape }}</strong><p>{{ block.settings.label | escape }}</p></div>{%- endfor -%}</div>
      {%- if section.settings.footnote != blank -%}<p class="res__note">{{ section.settings.footnote | escape }}</p>{%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{"name":"Results figures","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"heading","label":"Heading","default":"Genuine Change. [Calmer Parents.] Happier Kids."},{"type":"textarea","id":"text","label":"Text","default":"Describe what parents can expect with consistent daily use."},{"type":"text","id":"footnote","label":"Source note","default":"Only show figures you can source, and name the source here."}],
"blocks":[{"type":"card","name":"Figure card","settings":[{"type":"text","id":"icon","label":"Emoji","default":"♡"},{"type":"text","id":"figure","label":"Figure","default":"XX%","info":"Only use a figure you can back up."},{"type":"text","id":"label","label":"Label","default":"What the figure means"}]}],
"presets":[{"name":"Results figures","blocks":[{"type":"card"},{"type":"card"},{"type":"card"},{"type":"card"}]}]}
{% endschema %}
