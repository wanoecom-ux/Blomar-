<section class="ks ks--white">
  <div class="page-width vs__grid">
    <div class="vs__main">{%- if section.settings.main_video != blank -%}{{ section.settings.main_video | video_tag: controls: true, playsinline: true, preload: 'metadata' }}{%- else -%}{{ 'lifestyle-2' | placeholder_svg_tag }}{%- endif -%}<span class="vs__tag">● Now playing</span></div>
    <div class="vs__copy">
      <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h2 class="kh2">{% render 'hl', text: section.settings.heading %}</h2>
      <p class="ktext">{{ section.settings.text | escape }}</p>
      <div class="vs__thumbs">{%- for block in section.blocks -%}<div class="vs__thumb" {{ block.shopify_attributes }}>{%- if block.settings.video != blank -%}{{ block.settings.video | video_tag: controls: true, playsinline: true, preload: 'metadata' }}{%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag }}<span class="kp__play">▶</span>{%- endif -%}</div>{%- endfor -%}</div>
      <p class="vs__note">{{ section.settings.note | escape }}</p>
    </div>
  </div>
</section>
{% schema %}
{"name":"Parent video clips","settings":[{"type":"video","id":"main_video","label":"Main video"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"REAL PARENTS, REAL KIDS"},{"type":"text","id":"heading","label":"Heading","default":"Hear it from [the parents] first."},{"type":"textarea","id":"text","label":"Text","default":"Short, unscripted clips from real parents."},{"type":"text","id":"note","label":"Small note","default":"Tap a clip to play it"}],
"blocks":[{"type":"clip","name":"Clip","settings":[{"type":"video","id":"video","label":"Video"}]}],"presets":[{"name":"Parent video clips","blocks":[{"type":"clip"},{"type":"clip"},{"type":"clip"}]}]}
{% endschema %}
